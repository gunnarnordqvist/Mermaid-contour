+import { Canvas } from '../canvas.js';
+import {
+  CELL_V1,
+  CELL_V6,
+  COL_LABEL_HEIGHT,
+  FOOTER_BAND,
+  LEGEND_BOTTOM,
+  LEGEND_TOP,
+  LEGEND_WIDTH,
+  LEGEND_WIDTH_V6,
+  MARGIN,
+  MARK_SCALE_V6,
+  ROW_LABEL_WIDTH,
+  TITLE_BAND,
+  FIG,
+  FONT_SIZE,
+  drawBackground,
+  drawLegend,
+  drawPanel,
+  drawSummary,
+  drawTitleFooter,
+  round,
+} from '../common.js';
+import type { ContourModel, ContourPanel } from '../types.js';
+
+/** V1 The landscape on one page (one panel, 11 by 7.5 in) and V6 the comparison (two panels, 16 by 8 in). */
+export function layoutLandscapeOrCompare(model: ContourModel): Canvas {
+  const panels: ContourPanel[] = model.panels.length ? model.panels : [{ name: '', units: [] }];
+  const compare = panels.length === 2;
+  const cv = compare ? new Canvas(16, 8) : new Canvas(FIG.W, FIG.H);
+  drawBackground(cv);
+  drawTitleFooter(cv, model);
+  if (!compare) {
+    const x0 = MARGIN + ROW_LABEL_WIDTH;
+    const top = cv.height - TITLE_BAND;
+    const bottom = FOOTER_BAND;
+    const block = 4 * CELL_V1 + COL_LABEL_HEIGHT;
+    const y0 = round(bottom + COL_LABEL_HEIGHT + (top - bottom - block) / 2, 4);
+    drawPanel(cv, { x0, y0, cell: CELL_V1 }, panels[0].units);
+    drawLegend(
+      cv,
+      cv.width - MARGIN - LEGEND_WIDTH,
+      cv.height - LEGEND_TOP,
+      LEGEND_BOTTOM,
+      LEGEND_WIDTH
+    );
+    return cv;
+  }
+  const cell = CELL_V6;
+  const panelW = 5 * cell;
+  const legendGap = 0.2;
+  const panelTitleH = 0.3;
+  const summaryH = 0.95;
+  const xLeft = MARGIN + ROW_LABEL_WIDTH;
+  const legendX = xLeft + panelW + legendGap + 0.12;
+  const xRight = legendX + LEGEND_WIDTH_V6 + legendGap;
+  const block = panelTitleH + 4 * cell + COL_LABEL_HEIGHT + summaryH;
+  const top = cv.height - TITLE_BAND;
+  const bottom = FOOTER_BAND;
+  const y0 = round(bottom + summaryH + COL_LABEL_HEIGHT + (top - bottom - block) / 2, 4);
+  const sides: [ContourPanel, number, boolean][] = [
+    [panels[0], xLeft, true],
+    [panels[1], xRight, false],
+  ];
+  for (const [p, x0, labels] of sides) {
+    const g = { x0, y0, cell };
+    cv.text(x0, y0 + 4 * cell + 0.14, `${p.name} · ${p.units.length} units`, {
+      size: FONT_SIZE + 2,
+      weight: 'bold',
+    });
+    drawPanel(cv, g, p.units, { rowLabels: labels, scale: MARK_SCALE_V6 });
+    drawSummary(cv, x0, y0 - COL_LABEL_HEIGHT - 0.05, p.units);
+  }
+  drawLegend(cv, legendX, cv.height - LEGEND_TOP, LEGEND_BOTTOM, LEGEND_WIDTH_V6, MARK_SCALE_V6);
+  return cv;
+}
