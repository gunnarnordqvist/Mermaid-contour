+// cspell:ignore zorder capstyle textwrap
+/**
+ * The core shared by the six views of Contour: scales, palette, geometry in inches and the marks.
+ *
+ * This is a port of scripts/render_landscape.py (through the standalone mermaid-contour.mjs). One
+ * inch is 100 SVG user units. Every constant and algorithm is kept as it is there, so that a
+ * diagram has the pixels of the figure in the book.
+ */
+import type { Canvas, CircleOptions } from './canvas.js';
+import type { ContourModel, ContourUnit, EvidenceKind, Reach, Reversibility } from './types.js';
+
+// ---------------------------------------------------------------------------
+// Scales and palette (docs/NOTATION.md, docs/chart_palette.json)
+// ---------------------------------------------------------------------------
+export const LEVEL_NAMES = [
+  'Level 0 Advisory',
+  'Level 1 Assisted',
+  'Level 2 Supervised',
+  'Level 3 Bounded',
+  'Level 4 Autonomous',
+] as const;
+export const REV_NAMES: Record<Reversibility, string> = {
+  R1: 'Reversible at once',
+  R2: 'Reversible with effort',
+  R3: 'Hard to reverse',
+  R4: 'Irreversible',
+};
+/** Bottom row to top row. */
+export const REV_ORDER: readonly Reversibility[] = ['R1', 'R2', 'R3', 'R4'];
+export const REACH_RATIO: Record<Reach, number> = { S: 1.0, M: 1.6, L: 2.4, XL: 3.4 };
+export const REACH_LABELS: Record<Reach, string> = {
+  S: 'S under 100',
+  M: 'M 100 to 999',
+  L: 'L 1,000 to 9,999',
+  XL: 'XL 10,000 and more',
+};
+export const PAL = {
+  background: '#F8FAFF',
+  ink: '#182033',
+  muted: '#4F5B71',
+  grid: '#DFE5EE',
+  people: '#6B7280',
+  emptyCorner: '#FBE9E7',
+  warning: '#C0392B',
+  ice: '#E0F2FE',
+  supplier: '#A3927F',
+  nonEu: '#8C6D4E',
+  automatic: '#182033',
+  attested: '#6B7280',
+  modes: [
+    ['Mode 0 Ambient AI', '#7890B0'],
+    ['Mode 1 Conversational assistants', '#3B82F6'],
+    ['Mode 2 Embedded workplace assistants', '#40A090'],
+    ['Mode 3 Agentic work tools', '#C88000'],
+    ['Mode 4 Built AI applications', '#1B3A7A'],
+    ['Mode 5 Autonomous production agents', '#B2367D'],
+  ] as readonly (readonly [string, string])[],
+  ramp: ['#DCE6F7', '#AEC3E8', '#7897D3', '#4466B4', '#1B3A7A'] as readonly string[],
+};
+export const FONT = "Inter, 'DejaVu Sans', Arial, sans-serif";
+
+export const SUPPLIER_ROLE_NAMES = {
+  model: 'Model provider',
+  hosting: 'Hosting',
+  application: 'Application',
+  operations: 'Operations',
+} as const;
+/** The columns of the evidence view (V5): evidence kind and heading. */
+export const EVIDENCE_COLUMNS: readonly (readonly [EvidenceKind | 'none', string])[] = [
+  ['logs', 'Logs'],
+  ['tests', 'Tests and evaluations'],
+  ['gates', 'Gates and policies as code'],
+  ['attestations', 'Attestations'],
+  ['none', 'None'],
+];
+export const AUTOMATIC_KINDS: readonly EvidenceKind[] = ['logs', 'tests', 'gates'];
+
+// ---------------------------------------------------------------------------
+// Geometry, in inches (scripts/render_landscape.py)
+// ---------------------------------------------------------------------------
+export const UNIT_RADIUS = 0.075;
+export const SQUARE_FACTOR = Math.sqrt(Math.PI) / 2;
+export const DIAMOND_HALF = 0.055;
+export const SEAT_RADIUS = 0.07;
+export const SEAT_GAP = 0.02;
+export const BASELINE_GAP = 0.045;
+export const LABEL_GAP = 0.02;
+export const LABEL_HEIGHT = 0.13;
+export const CHAR_WIDTH = 0.07;
+export const LINE_PITCH = 0.15;
+export const CELL_V1 = 1.46;
+export const CELL_V6 = 1.28;
+export const MARK_SCALE_V6 = CELL_V6 / CELL_V1;
+export const LEGEND_WIDTH = 2.0;
+export const LEGEND_WIDTH_V6 = 1.7;
+export const ROW_LABEL_WIDTH = 0.5;
+export const COL_LABEL_HEIGHT = 0.45;
+export const TITLE_BAND = 0.55;
+export const FOOTER_BAND = 0.46;
+export const FOOTER_LINE = 0.14;
+export const LEGEND_TOP = 0.3;
+export const LEGEND_BOTTOM = FOOTER_BAND + 0.04;
+export const MARGIN = 0.3;
+export const SIZE_BLOCK_HEIGHT = 0.66;
+export const FONT_SIZE = 9;
+export const TITLE_SIZE = 14;
+export const ITEM_GAP_X = 0.04;
+export const ITEM_GAP_Y = 0.04;
+export const IN = 100;
+export const PT = IN / 72;
+
+// Decisions (V4) and evidence (V5)
+export const MINI_RADIUS = 0.075;
+export const ROW_PITCH = 0.24;
+export const ACTION_PITCH = 0.145;
+export const ROW_PITCH_EVIDENCE = 0.3;
+export const LABEL_AREA = 3.2;
+/** The standard figure of views V2 to V5: 11 by 7.5 inches (V1 is the same, V6 is 16 by 8). */
+export const FIG_W = 11;
+export const FIG_H = 7.5;
+export const FIG = { W: FIG_W, H: FIG_H } as const;
+
+// Supply (V3)
+export const BOX_PAD = 0.1;
+export const BOX_TITLE_LINE = 0.15;
+export const BOX_GAP = 0.12;
+export const ITEM_GAP = 0.08;
+
+export const round = (v: number, d: number): number => {
+  const f = 10 ** d;
+  return Math.round(v * f) / f;
+};
+
+// ---------------------------------------------------------------------------
+// Unit helpers
+// ---------------------------------------------------------------------------
+export const radius = (u: Pick<ContourUnit, 'reach'>, scale = 1): number =>
+  UNIT_RADIUS * REACH_RATIO[u.reach] * scale;
+
+export const halfExtent = (u: Pick<ContourUnit, 'reach' | 'identity'>, scale = 1): number =>
+  u.identity === 'person' ? radius(u, scale) : radius(u, scale) * SQUARE_FACTOR;
+
+export const hollow = (u: Pick<ContourUnit, 'status'>): boolean =>
+  u.status === 'paused' || u.status === 'retired';
+
+/** A unit at Level 3 whose policy point is not enforced is outlined in the warning colour. */
+export const redRule = (u: Pick<ContourUnit, 'level' | 'policy'>): boolean =>
+  u.level === 3 && u.policy !== 'enforced';
+
+export const textWidth = (s: string, size = FONT_SIZE): number =>
+  s.length * CHAR_WIDTH * (size / FONT_SIZE);
+
+const compareStrings = (a: string, b: string): number => (a < b ? -1 : a > b ? 1 : 0);
+
+// WCAG contrast, to choose white or ink text on a fill
+const luminance = (colour: string): number => {
+  const channel = (v: number) => {
+    const x = v / 255;
+    return x <= 0.03928 ? x / 12.92 : ((x + 0.055) / 1.055) ** 2.4;
+  };
+  const [r, g, b] = [1, 3, 5].map((i) => parseInt(colour.slice(i, i + 2), 16));
+  return 0.2126 * channel(r) + 0.7152 * channel(g) + 0.0722 * channel(b);
+};
+const contrast = (a: string, b: string): number => {
+  const [la, lb] = [luminance(a), luminance(b)];
+  return (Math.max(la, lb) + 0.05) / (Math.min(la, lb) + 0.05);
+};
+export const textOn = (fill: string): string =>
+  contrast(fill, '#FFFFFF') >= contrast(fill, PAL.ink) ? '#FFFFFF' : PAL.ink;
+export const modeColour = (m: number): string => PAL.modes[m][1];
+
+/** Word wrap like Python's textwrap.wrap: break at spaces and after a hyphen between letters. */
+export function wrapToWidth(
+  s: string,
+  width: number,
+  size = FONT_SIZE,
+  maxLines: number | null = null
+): string[] {
+  const chars = Math.max(8, Math.floor(width / ((CHAR_WIDTH * size) / FONT_SIZE)));
+  const chunks: string[] = [];
+  for (const part of s.trim().split(/(\s+)/)) {
+    if (!part) {
+      continue;
+    }
+    if (/^\s+$/.test(part)) {
+      chunks.push(' ');
+    } else {
+      chunks.push(
+        ...part.replace(/([^\s\w]*\w+[^\W\d]-)(?=\w+[^\W\d])/g, '$1\u0001').split('\u0001')
+      );
+    }
+  }
+  const lines: string[] = [];
+  let cur: string[] = [];
+  let len = 0;
+  const flush = () => {
+    while (cur.length && cur[cur.length - 1] === ' ') {
+      cur.pop();
+    }
+    lines.push(cur.join(''));
+    cur = [];
+    len = 0;
+  };
+  while (chunks.length) {
+    const c = chunks[0];
+    if (c === ' ' && !cur.length) {
+      chunks.shift();
+      continue;
+    }
+    if (len + c.length <= chars) {
+      cur.push(chunks.shift()!);
+      len += c.length;
+      continue;
+    }
+    if (c.length > chars && !cur.length) {
+      cur.push(c.slice(0, chars));
+      chunks[0] = c.slice(chars);
+      flush();
+      continue;
+    }
+    flush();
+  }
+  if (cur.length) {
+    flush();
+  }
+  if (!lines.length) {
+    lines.push('');
+  }
+  if (maxLines && lines.length > maxLines) {
+    lines.length = maxLines;
+    lines[maxLines - 1] = lines[maxLines - 1].slice(0, Math.max(1, chars - 1)).trimEnd() + '…';
+  }
+  return lines;
+}
+
+export function truncateToWidth(s: string, width: number, size = FONT_SIZE): string {
+  const chars = Math.max(4, Math.floor(width / ((CHAR_WIDTH * size) / FONT_SIZE)));
+  return s.length <= chars ? s : s.slice(0, chars - 1).trimEnd() + '…';
+}
+
+// ---------------------------------------------------------------------------
+// Marks
+// ---------------------------------------------------------------------------
+/** Room a mark takes around its centre, in inches. */
+export interface Footprint {
+  left: number;
+  right: number;
+  up: number;
+  down: number;
+  width: number;
+}
+
+export interface FootprintOptions {
+  seat?: boolean;
+  label?: boolean;
+  isNew?: boolean;
+  scale?: number;
+}
+
+export const labelBeside = (u: Pick<ContourUnit, 'reach'>): boolean =>
+  u.reach === 'S' || u.reach === 'M';
+
+export function markFootprint(
+  u: ContourUnit,
+  { seat = true, label = true, isNew = false, scale = 1 }: FootprintOptions = {}
+): Footprint {
+  const e = halfExtent(u, scale);
+  let left = e + DIAMOND_HALF + 0.01;
+  let right = e + 0.02;
+  const up = e + (seat && u.tier !== 'T0' ? SEAT_GAP + 2 * SEAT_RADIUS : 0.03);
+  let down = e + BASELINE_GAP + 0.03;
+  if (label && labelBeside(u)) {
+    right = e + LABEL_GAP + 0.02 + textWidth(u.id) + 0.08 + (isNew ? textWidth('new') + 0.2 : 0);
+    down = Math.max(down, LABEL_HEIGHT / 2);
+  } else if (label) {
+    const half = textWidth(u.id) / 2 + 0.04;
+    left = Math.max(left, half);
+    right = Math.max(right, half);
+    down += LABEL_GAP + LABEL_HEIGHT + (isNew ? LABEL_HEIGHT : 0);
+  }
+  return { left, right, up, down, width: left + right };
+}
+
+export function ghostFootprint(u: ContourUnit, scale = 1): Footprint {
+  const e = halfExtent(u, scale) + 0.02;
+  return { left: e, right: e, up: e, down: e, width: 2 * e };
+}
+
+export const digitSize = (r: number): number => Math.max(FONT_SIZE, Math.min(12.0, 4.0 + r * 32.0));
+
+export function drawShape(
+  cv: Canvas,
+  x: number,
+  y: number,
+  u: Pick<ContourUnit, 'identity'>,
+  half: number,
+  o: CircleOptions
+): void {
+  if (u.identity === 'person') {
+    cv.circle(x, y, half, o);
+  } else {
+    cv.roundedSquare(x, y, half, o);
+  }
+}
+
+export interface DrawMarkOptions {
+  label?: boolean;
+  scale?: number;
+  hollowOverride?: boolean | null;
+  crossedOverride?: boolean | null;
+  isNew?: boolean;
+}
+
+export function drawMark(
+  cv: Canvas,
+  x: number,
+  y: number,
+  u: ContourUnit,
+  {
+    label = true,
+    scale = 1,
+    hollowOverride = null,
+    crossedOverride = null,
+    isNew = false,
+  }: DrawMarkOptions = {}
+): void {
+  const colour = modeColour(u.mode);
+  const hol = hollowOverride ?? hollow(u);
+  const e = halfExtent(u, scale);
+  drawShape(cv, x, y, u, e, {
+    face: hol ? PAL.background : colour,
+    edge: colour,
+    lw: 1.4,
+    zorder: 4,
+  });
+  if (redRule(u)) {
+    drawShape(cv, x, y, u, e + 0.03, { face: 'none', edge: PAL.warning, lw: 1.3, zorder: 3.5 });
+  }
+  cv.text(x, y, String(u.mode), {
+    size: digitSize(radius(u, scale)),
+    colour: hol ? colour : textOn(colour),
+    ha: 'center',
+    weight: 'bold',
+    zorder: 5,
+  });
+  if (crossedOverride ?? u.status === 'retired') {
+    const d = e * 0.75;
+    cv.line([x - d, x + d], [y - d, y + d], { colour: PAL.ink, lw: 1.3, zorder: 5.5 });
+    cv.line([x - d, x + d], [y + d, y - d], { colour: PAL.ink, lw: 1.3, zorder: 5.5 });
+  }
+  if (u.policy !== 'none') {
+    cv.diamond(x - e, y, DIAMOND_HALF, { filled: u.policy === 'enforced', colour: PAL.ink });
+  }
+  if (u.tier !== 'T0') {
+    const cy = y + e + SEAT_GAP + SEAT_RADIUS;
+    cv.circle(x, cy, SEAT_RADIUS, { face: PAL.people, edge: PAL.people, lw: 0, zorder: 4 });
+    cv.text(x, cy, u.tier[1], { colour: '#FFFFFF', ha: 'center', weight: 'bold', zorder: 5 });
+  }
+  const yBase = y - e - BASELINE_GAP;
+  if (u.evidence !== 'none') {
+    const half = Math.max(0.8 * e, 0.1);
+    if (u.evidence === 'automatic') {
+      cv.line([x - half, x + half], [yBase, yBase], { colour: PAL.automatic, lw: 1.8, zorder: 4 });
+    } else {
+      cv.line([x - half, x + half], [yBase, yBase], {
+        colour: PAL.attested,
+        lw: 1.8,
+        dashes: [3, 2],
+        zorder: 4,
+      });
+    }
+  }
+  // An invisible marker that lets a test read back where the mark was drawn.
+  cv.push(9, 'desc', { 'data-unit': u.id, 'data-x': round(x, 4), 'data-y': round(y, 4) });
+  let tickX: number;
+  let tickY: number;
+  if (label && labelBeside(u)) {
+    const lx = x + e + LABEL_GAP + 0.02;
+    cv.text(lx, y, u.id, { colour: PAL.muted });
+    [tickX, tickY] = [lx + textWidth(u.id) + 0.16, y];
+  } else if (label) {
+    cv.text(x, yBase - 0.02 - LABEL_GAP, u.id, { colour: PAL.muted, ha: 'center', va: 'top' });
+    [tickX, tickY] = [x - 0.14, yBase - 0.02 - LABEL_GAP - LABEL_HEIGHT - 0.06];
+  } else {
+    [tickX, tickY] = [x + e + 0.08, y];
+  }
+  if (isNew) {
+    // a small tick and the word "new" beside or under the label
+    cv.line([tickX - 0.05, tickX - 0.02, tickX + 0.04], [tickY, tickY - 0.04, tickY + 0.055], {
+      colour,
+      lw: 1.6,
+      zorder: 6,
+      capstyle: 'round',
+    });
+    cv.text(tickX + 0.08, tickY, 'new', { colour });
+  }
+}
+
+export function drawGhost(cv: Canvas, x: number, y: number, u: ContourUnit, scale = 1): void {
+  drawShape(cv, x, y, u, halfExtent(u, scale), {
+    face: 'none',
+    edge: modeColour(u.mode),
+    lw: 1.0,
+    zorder: 2.5,
+  });
+}
+
+export function drawMiniMark(
+  cv: Canvas,
+  x: number,
+  y: number,
+  u: ContourUnit,
+  r = MINI_RADIUS
+): void {
+  const colour = modeColour(u.mode);
+  const hol = hollow(u);
+  const half = u.identity === 'person' ? r : r * SQUARE_FACTOR;
+  drawShape(cv, x, y, u, half, {
+    face: hol ? PAL.background : colour,
+    edge: colour,
+    lw: 1.2,
+    zorder: 4,
+  });
+  cv.text(x, y, String(u.mode), {
+    colour: hol ? colour : textOn(colour),
+    ha: 'center',
+    weight: 'bold',
+    zorder: 5,
+  });
+  if (u.status === 'retired') {
+    const d = half * 0.75;
+    cv.line([x - d, x + d], [y - d, y + d], { colour: PAL.ink, lw: 1.1, zorder: 5.5 });
+    cv.line([x - d, x + d], [y + d, y - d], { colour: PAL.ink, lw: 1.1, zorder: 5.5 });
+  }
+}
+
+// ---------------------------------------------------------------------------
+// Layout of several marks in one cell
+// ---------------------------------------------------------------------------
+/** An item to place: a key, its footprint and whatever the view wants to carry along. */
+export interface LayoutItem {
+  key: string;
+  fp: Footprint;
+  u?: ContourUnit;
+}
+
+export type Positions = Record<string, [number, number]>;
+export type CellEdge = 'top' | 'bottom' | null;
+
+export function packRows<T extends { fp: Footprint }>(items: readonly T[], maxW: number): T[][] {
+  const rows: T[][] = [[]];
+  let used = 0;
+  for (const it of items) {
+    const w = it.fp.width;
+    if (rows[rows.length - 1].length && used + ITEM_GAP_X + w > maxW) {
+      rows.push([]);
+      used = 0;
+    }
+    if (rows[rows.length - 1].length) {
+      used += ITEM_GAP_X;
+    }
+    rows[rows.length - 1].push(it);
+    used += w;
+  }
+  return rows;
+}
+
+export const rowsExtent = <T extends { fp: Footprint }>(rows: readonly T[][]): [number, number] => [
+  Math.max(
+    ...rows.map((r) => r.reduce((s, it) => s + it.fp.width, 0) + ITEM_GAP_X * (r.length - 1))
+  ),
+  rows.reduce(
+    (s, r) => s + Math.max(...r.map((it) => it.fp.up)) + Math.max(...r.map((it) => it.fp.down)),
+    0
+  ) +
+    ITEM_GAP_Y * (rows.length - 1),
+];
+
+/**
+ * Positions the items of one grid cell, relative to the cell centre. The candidate packings are
+ * tried in a fixed order and the one with the least overflow wins, so the result is deterministic.
+ */
+export function layoutInCell<T extends { key: string; fp: Footprint }>(
+  items: readonly T[],
+  cellW: number,
+  cellH: number,
+  edge: CellEdge = null
+): Positions {
+  if (!items.length) {
+    return {};
+  }
+  const ordered = [...items].sort((a, b) => {
+    const ka = -(a.fp.width * (a.fp.up + a.fp.down));
+    const kb = -(b.fp.width * (b.fp.up + b.fp.down));
+    return ka - kb || compareStrings(a.key, b.key);
+  });
+  const pad = 0.05;
+  const candidates: T[][][] = [[[...ordered]]];
+  for (const f of [1.3, 1.2, 1.1, 1.0, 0.9, 0.8, 0.6, 0.45]) {
+    candidates.push(packRows(ordered, (cellW - 2 * pad) * f));
+  }
+  candidates.push(ordered.map((it) => [it]));
+  const overflow = (rows: T[][]): [number, number] => {
+    const [w, h] = rowsExtent(rows);
+    return [
+      round(3 * Math.max(w - (cellW - 2 * pad), 0) + Math.max(h - (cellH - 2 * pad), 0), 4),
+      rows.length,
+    ];
+  };
+  let best = candidates[0];
+  let bo = overflow(best);
+  for (const c of candidates.slice(1)) {
+    const o = overflow(c);
+    if (o[0] < bo[0] || (o[0] === bo[0] && o[1] < bo[1])) {
+      best = c;
+      bo = o;
+    }
+  }
+  const [, height] = rowsExtent(best);
+  const pos: Positions = {};
+  let cy = height / 2;
+  for (const row of best) {
+    const up = Math.max(...row.map((it) => it.fp.up));
+    const down = Math.max(...row.map((it) => it.fp.down));
+    const rowW = row.reduce((s, it) => s + it.fp.width, 0) + ITEM_GAP_X * (row.length - 1);
+    let cx = -rowW / 2;
+    for (const it of row) {
+      pos[it.key] = [round(cx + it.fp.left, 6), round(cy - up, 6)];
+      cx += it.fp.width + ITEM_GAP_X;
+    }
+    cy -= up + down + ITEM_GAP_Y;
+  }
+  if (edge === 'top' || edge === 'bottom') {
+    const excess = height / 2 - (cellH / 2 - pad);
+    if (excess > 0) {
+      const shift = edge === 'top' ? -excess : excess;
+      for (const k of Object.keys(pos)) {
+        pos[k] = [pos[k][0], round(pos[k][1] + shift, 6)];
+      }
+    }
+  }
+  return pos;
+}
+
+// ---------------------------------------------------------------------------
+// The grid
+// ---------------------------------------------------------------------------
+/** Origin (bottom left) and cell size of a grid of 5 columns and 4 rows, in inches. */
+export interface Grid {
+  x0: number;
+  y0: number;
+  cell: number;
+}
+
+export const gridCentre = (g: Grid, level: number, rev: Reversibility): [number, number] => [
+  g.x0 + (level + 0.5) * g.cell,
+  g.y0 + (REV_ORDER.indexOf(rev) + 0.5) * g.cell,
+];
+
+export function drawGrid(
+  cv: Canvas,
+  g: Grid,
+  { rowLabels = true }: { rowLabels?: boolean } = {}
+): void {
+  const { x0, y0, cell: c } = g;
+  cv.rect(x0 + 4 * c, y0 + 3 * c, c, c, { face: PAL.emptyCorner, zorder: 0.5 });
+  cv.text(x0 + 4.5 * c, y0 + 4 * c - 0.1, 'the empty corner', {
+    colour: PAL.warning,
+    ha: 'center',
+    va: 'top',
+    zorder: 1,
+    style: 'italic',
+  });
+  for (let i = 0; i < 6; i++) {
+    cv.line([x0 + i * c, x0 + i * c], [y0, y0 + 4 * c], {
+      colour: PAL.grid,
+      lw: i === 0 || i === 5 ? 0.8 : 0.6,
+      zorder: 1,
+    });
+  }
+  for (let j = 0; j < 5; j++) {
+    cv.line([x0, x0 + 5 * c], [y0 + j * c, y0 + j * c], {
+      colour: PAL.grid,
+      lw: j === 0 || j === 4 ? 0.8 : 0.6,
+      zorder: 1,
+    });
+  }
+  LEVEL_NAMES.forEach((name, i) => {
+    const [a, b, ...rest] = name.split(' ');
+    const cx = x0 + (i + 0.5) * c;
+    cv.text(cx, y0 - 0.09, `${a} ${b}`, {
+      size: FONT_SIZE + 0.5,
+      ha: 'center',
+      va: 'top',
+      weight: 'bold',
+    });
+    cv.text(cx, y0 - 0.25, rest.join(' '), { colour: PAL.muted, ha: 'center', va: 'top' });
+  });
+  if (rowLabels) {
+    REV_ORDER.forEach((tier, j) => {
+      const cy = y0 + (j + 0.5) * c;
+      cv.text(x0 - 0.3, cy, tier, {
+        size: FONT_SIZE + 0.5,
+        ha: 'center',
+        weight: 'bold',
+        rotation: 90,
+      });
+      cv.text(x0 - 0.14, cy, REV_NAMES[tier], { colour: PAL.muted, ha: 'center', rotation: 90 });
+    });
+  }
+}
+
+export function placeUnits(units: readonly ContourUnit[], g: Grid, scale: number): Positions {
+  const byCell = new Map<string, Required<LayoutItem>[]>();
+  for (const u of [...units].sort((a, b) => compareStrings(a.id, b.id))) {
+    const k = `${u.level},${u.reversibility}`;
+    if (!byCell.has(k)) {
+      byCell.set(k, []);
+    }
+    byCell.get(k)!.push({ key: u.id, fp: markFootprint(u, { scale }), u });
+  }
+  const out: Positions = {};
+  for (const items of byCell.values()) {
+    const { level, reversibility } = items[0].u;
+    const [cx, cy] = gridCentre(g, level, reversibility);
+    const edge: CellEdge =
+      reversibility === 'R4' ? 'top' : reversibility === 'R1' ? 'bottom' : null;
+    const p = layoutInCell(items, g.cell, g.cell, edge);
+    for (const k of Object.keys(p)) {
+      out[k] = [cx + p[k][0], cy + p[k][1]];
+    }
+  }
+  return out;
+}
+
+export function drawPanel(
+  cv: Canvas,
+  g: Grid,
+  units: readonly ContourUnit[],
+  { rowLabels = true, scale = 1 }: { rowLabels?: boolean; scale?: number } = {}
+): Positions {
+  drawGrid(cv, g, { rowLabels });
+  const pos = placeUnits(units, g, scale);
+  for (const u of units) {
+    const [x, y] = pos[u.id];
+    drawMark(cv, x, y, u, { scale });
+  }
+  return pos;
+}
+
+// ---------------------------------------------------------------------------
+// Legend and summary strip
+// ---------------------------------------------------------------------------
+export type Swatch = (cv: Canvas, x: number, y: number) => void;
+
+export interface LegendItem {
+  lines: string[];
+  header?: boolean;
+  height?: number;
+  swatch?: Swatch | null;
+}
+
+export interface LegendOptions {
+  /** Add the trail entries of the year view (V2). */
+  trail?: boolean;
+  /** Add the container entries of the supply view (V3). */
+  containers?: boolean;
+}
+
+export function legendItems(
+  width: number,
+  { trail = false, containers = false }: LegendOptions = {}
+): LegendItem[] {
+  const swW = 0.24;
+  const textW = width - swW;
+  const items: LegendItem[] = [];
+  const header = (t: string) => items.push({ lines: [t], header: true });
+  const line = (t: string, swatch: Swatch | null = null) =>
+    items.push({ lines: wrapToWidth(t, swatch ? textW : width), swatch });
+  const modeSw =
+    (m: number): Swatch =>
+    (cv, x, y) => {
+      const c = modeColour(m);
+      cv.circle(x + 0.075, y, 0.07, { face: c, edge: c, lw: 0 });
+      cv.text(x + 0.075, y, String(m), { colour: textOn(c), ha: 'center', weight: 'bold' });
+    };
+  header('Columns: autonomy level');
+  LEVEL_NAMES.forEach((n) => line(n));
+  header('Rows: reversibility');
+  [...REV_ORDER].reverse().forEach((t) => line(`${t} ${REV_NAMES[t]}`));
+  header('Size: reach (people a year)');
+  items.push({ lines: ['__sizes__'], height: SIZE_BLOCK_HEIGHT });
+  header('Colour: usage mode');
+  PAL.modes.forEach(([name], m) => line(name, modeSw(m)));
+  header('Shape: identity');
+  line("a person's identity", (cv, x, y) =>
+    cv.circle(x + 0.075, y, 0.07, { face: PAL.background, edge: PAL.ink, lw: 1.2 })
+  );
+  line('an identity of its own', (cv, x, y) =>
+    cv.roundedSquare(x + 0.075, y, 0.07 * SQUARE_FACTOR + 0.005, {
+      face: PAL.background,
+      edge: PAL.ink,
+      lw: 1.2,
+    })
+  );
+  header('Diamond: policy point');
+  line('enforced', (cv, x, y) =>
+    cv.diamond(x + 0.075, y, DIAMOND_HALF, { filled: true, colour: PAL.ink })
+  );
+  line('planned; absent: none', (cv, x, y) =>
+    cv.diamond(x + 0.075, y, DIAMOND_HALF, { filled: false, colour: PAL.ink })
+  );
+  header('Seat: decision tier');
+  line('T1 to T4; absent: T0', (cv, x, y) => {
+    cv.circle(x + 0.075, y, SEAT_RADIUS, { face: PAL.people, edge: PAL.people, lw: 0 });
+    cv.text(x + 0.075, y, '2', { colour: '#FFFFFF', ha: 'center', weight: 'bold' });
+  });
+  header('Baseline: evidence');
+  line('automatic', (cv, x, y) =>
+    cv.line([x, x + 0.18], [y, y], { colour: PAL.automatic, lw: 1.8 })
+  );
+  line('attested; absent: none', (cv, x, y) =>
+    cv.line([x, x + 0.18], [y, y], { colour: PAL.attested, lw: 1.8, dashes: [3, 2] })
+  );
+  if (containers) {
+    const box =
+      (colour: string, dashes: readonly number[] | null): Swatch =>
+      (cv, x, y) =>
+        cv.rect(x, y - 0.06, 0.2, 0.12, {
+          face: 'none',
+          edge: colour,
+          lw: 1.0,
+          dashes,
+          rounding: 0.03,
+        });
+    header('Containers');
+    line('own boundary', box(PAL.ink, null));
+    line('supplier, by role', box(PAL.supplier, [4, 2]));
+    line('non-EU jurisdiction', box(PAL.nonEu, [1.2, 1.6]));
+    line('model from a supplier', (cv, x, y) => {
+      cv.rect(x, y - 0.055, 0.2, 0.11, {
+        face: PAL.background,
+        edge: PAL.supplier,
+        lw: 0.8,
+        rounding: 0.03,
+      });
+      cv.line([x - 0.04, x], [y, y], { colour: PAL.supplier, lw: 0.8 });
+    });
+  }
+  if (trail) {
+    const c4 = modeColour(4);
+    header('Trail');
+    line('earlier, trail, later', (cv, x, y) => {
+      cv.circle(x + 0.04, y, 0.04, { face: 'none', edge: c4, lw: 1.0 });
+      cv.line([x + 0.08, x + 0.15], [y, y], { colour: c4, lw: 1.0 });
+      cv.circle(x + 0.19, y, 0.045, { face: c4, edge: c4, lw: 1.0 });
+    });
+    line('new in the period', (cv, x, y) =>
+      cv.line([x + 0.03, x + 0.07, x + 0.16], [y, y - 0.045, y + 0.06], {
+        colour: c4,
+        lw: 1.6,
+        capstyle: 'round',
+      })
+    );
+    line('retired', (cv, x, y) => {
+      cv.circle(x + 0.075, y, 0.065, { face: PAL.background, edge: c4, lw: 1.2 });
+      const d = 0.045;
+      cv.line([x + 0.075 - d, x + 0.075 + d], [y - d, y + d], { colour: PAL.ink, lw: 1.1 });
+      cv.line([x + 0.075 - d, x + 0.075 + d], [y + d, y - d], { colour: PAL.ink, lw: 1.1 });
+    });
+  }
+  return items;
+}
+
+export function drawLegend(
+  cv: Canvas,
+  x: number,
+  top: number,
+  bottom: number,
+  width: number,
+  scale = 1,
+  opts: LegendOptions = {}
+): void {
+  const items = legendItems(width, opts);
+  const sectionGap = 0.05;
+  const total = (pitch: number) =>
+    items.reduce(
+      (s, it) => s + (it.header ? sectionGap : 0) + (it.height ?? pitch * it.lines.length),
+      0
+    );
+  let pitch = LINE_PITCH;
+  while (total(pitch) > top - bottom && pitch > 0.135) {
+    pitch -= 0.005;
+  }
+  if (total(pitch) > top - bottom) {
+    throw new Error(
+      `Contour: the legend needs ${total(pitch).toFixed(2)} in, ${(top - bottom).toFixed(2)} in available`
+    );
+  }
+  cv.line([x - 0.12, x - 0.12], [bottom, top], { colour: PAL.grid, lw: 0.8 });
+  let y = top;
+  for (const it of items) {
+    if (it.header) {
+      y -= sectionGap;
+      cv.text(x, y - pitch / 2, it.lines[0], { weight: 'bold' });
+      y -= pitch;
+      continue;
+    }
+    if (it.lines[0] === '__sizes__') {
+      const blockH = it.height ?? SIZE_BLOCK_HEIGHT;
+      const rXL = UNIT_RADIUS * REACH_RATIO.XL * scale;
+      const cx = x + rXL + 0.02;
+      const bottomY = y - blockH + 0.04;
+      const labelX = cx + rXL + 0.22;
+      const sizes: Reach[] = ['S', 'M', 'L', 'XL'];
+      sizes.forEach((reach, k) => {
+        const r = UNIT_RADIUS * REACH_RATIO[reach] * scale;
+        const ly = bottomY + 0.05 + k * 0.155;
+        cv.circle(cx, bottomY + r, r, { face: 'none', edge: PAL.ink, lw: 1 });
+        const topY = bottomY + 2 * r;
+        cv.line([cx, cx + rXL + 0.08, labelX - 0.04], [topY, topY, ly], {
+          colour: PAL.grid,
+          lw: 0.7,
+          zorder: 2,
+        });
+        cv.text(labelX, ly, REACH_LABELS[reach]);
+      });
+      y -= blockH;
+      continue;
+    }
+    if (it.swatch) {
+      it.swatch(cv, x, y - pitch / 2);
+    }
+    const tx = it.swatch ? x + 0.24 : x;
+    it.lines.forEach((t, k) => cv.text(tx, y - pitch / 2 - k * pitch, t));
+    y -= pitch * it.lines.length;
+  }
+}
+
+export function drawSummary(
+  cv: Canvas,
+  x: number,
+  top: number,
+  units: readonly ContourUnit[]
+): void {
+  const per = (f: (u: ContourUnit) => number, n: number) =>
+    Array.from({ length: n }, (_, i) => units.filter((u) => f(u) === i).length);
+  const perMode = per((u) => u.mode, 6);
+  const perLevel = per((u) => u.level, 5);
+  cv.text(x, top - 0.08, `Units drawn: ${units.length}`, { weight: 'bold' });
+  const step = 0.42;
+  const start = x + 0.95;
+  const yMode = top - 0.34;
+  const yLevel = top - 0.6;
+  cv.text(x, yMode, 'Per mode', { colour: PAL.muted });
+  for (let m = 0; m < 6; m++) {
+    const cx = start + m * step;
+    const c = modeColour(m);
+    cv.circle(cx, yMode, 0.07, { face: c, edge: c, lw: 0 });
+    cv.text(cx, yMode, String(m), { colour: textOn(c), ha: 'center', weight: 'bold' });
+    cv.text(cx + 0.11, yMode, String(perMode[m]));
+  }
+  cv.text(x, yLevel, 'Per level', { colour: PAL.muted });
+  for (let l = 0; l < 5; l++) {
+    const cx = start + l * step;
+    const c = PAL.ramp[l];
+    cv.rect(cx - 0.07, yLevel - 0.065, 0.14, 0.13, { face: c, edge: PAL.ink, lw: 0.5 });
+    cv.text(cx, yLevel, String(l), { colour: textOn(c), ha: 'center', weight: 'bold' });
+    cv.text(cx + 0.11, yLevel, String(perLevel[l]));
+  }
+  const n = (f: (u: ContourUnit) => boolean) => units.filter(f).length;
+  cv.text(
+    x,
+    top - 0.84,
+    `Filled diamond ${n((u) => u.policy === 'enforced')} · Seat ${n((u) => u.tier !== 'T0')} · Solid baseline ${n((u) => u.evidence === 'automatic')} of ${units.length}`
+  );
+}
+
+export function drawTitleFooter(cv: Canvas, model: ContourModel): void {
+  if (model.title) {
+    cv.text(MARGIN, cv.height - 0.22, model.title, { size: TITLE_SIZE, weight: 'bold' });
+  }
+  if (model.subtitle) {
+    cv.text(MARGIN, cv.height - 0.47, model.subtitle, { colour: PAL.muted });
+  }
+  [...model.footer].reverse().forEach((t, k) => {
+    cv.text(MARGIN, 0.09 + k * FOOTER_LINE, t, { colour: PAL.muted });
+  });
+}
