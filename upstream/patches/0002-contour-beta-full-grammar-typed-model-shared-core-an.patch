+// cspell:ignore zorder capstyle
+import { FONT, FONT_SIZE, IN, PAL, PT, round } from './common.js';
+
+const NS = 'http://www.w3.org/2000/svg';
+
+/** Attribute values of an SVG element; null and undefined leave the attribute out. */
+export type SvgAttributes = Record<string, string | number | null | undefined>;
+
+export interface TextOptions {
+  size?: number;
+  colour?: string;
+  ha?: 'left' | 'center' | 'right';
+  va?: 'center' | 'top' | 'bottom';
+  weight?: 'normal' | 'bold';
+  rotation?: number;
+  zorder?: number;
+  style?: 'normal' | 'italic';
+}
+
+export interface LineOptions {
+  colour: string;
+  lw?: number;
+  dashes?: readonly number[] | null;
+  zorder?: number;
+  capstyle?: 'butt' | 'round' | 'square';
+}
+
+export interface RectOptions {
+  face?: string;
+  edge?: string;
+  lw?: number;
+  zorder?: number;
+  rounding?: number;
+  hatch?: string | null;
+  dashes?: readonly number[] | null;
+}
+
+export interface CircleOptions {
+  face: string;
+  edge: string;
+  lw?: number;
+  zorder?: number;
+}
+
+export interface DiamondOptions {
+  filled: boolean;
+  colour: string;
+  zorder?: number;
+}
+
+interface Item {
+  z: number;
+  i: number;
+  el: Element;
+}
+
+let patternCounter = 0;
+
+/**
+ * Primitives in inches, origin bottom left, y up, stacked by z-order like matplotlib. One inch is
+ * 100 SVG user units and one point is 100/72 units, so a diagram drawn here has the pixels of the
+ * figure that scripts/render_landscape.py draws.
+ */
+export class Canvas {
+  public readonly width: number;
+  public readonly height: number;
+  private readonly items: Item[] = [];
+  private readonly defs: Element[] = [];
+
+  public constructor(width: number, height: number) {
+    this.width = width;
+    this.height = height;
+  }
+
+  /** matplotlib's hatch '////': 12 diagonal lines per inch tile, anchored at the canvas's bottom left. */
+  public hatchPattern(colour: string): string {
+    const id = `contour-hatch-${++patternCounter}`;
+    const pattern = document.createElementNS(NS, 'pattern');
+    const patternAttributes: SvgAttributes = {
+      id,
+      patternUnits: 'userSpaceOnUse',
+      x: 0,
+      y: round((this.height * IN) % IN, 2),
+      width: IN,
+      height: IN,
+    };
+    this.setAttributes(pattern, patternAttributes);
+    for (let j = 0; j <= 24; j++) {
+      const c = (IN * j) / 12;
+      const line = document.createElementNS(NS, 'line');
+      this.setAttributes(line, {
+        x1: -IN,
+        y1: round(c + IN, 2),
+        x2: 2 * IN,
+        y2: round(c - 2 * IN, 2),
+        stroke: colour,
+        'stroke-width': round(0.8 * PT, 2),
+      });
+      pattern.appendChild(line);
+    }
+    this.defs.push(pattern);
+    return id;
+  }
+
+  /** Inches from the left to SVG user units. */
+  public X(x: number): number {
+    return round(x * IN, 2);
+  }
+
+  /** Inches from the bottom to SVG user units (y down). */
+  public Y(y: number): number {
+    return round((this.height - y) * IN, 2);
+  }
+
+  /** Adds an element at a z-order; elements of equal z-order keep their order of insertion. */
+  public push(z: number, tag: string, attrs: SvgAttributes, text?: string): Element {
+    const el = document.createElementNS(NS, tag);
+    this.setAttributes(el, attrs);
+    if (text !== undefined) {
+      el.textContent = text;
+    }
+    this.items.push({ z, i: this.items.length, el });
+    return el;
+  }
+
+  public text(
+    x: number,
+    y: number,
+    s: string,
+    {
+      size = FONT_SIZE,
+      colour = PAL.ink,
+      ha = 'left',
+      va = 'center',
+      weight = 'normal',
+      rotation = 0,
+      zorder = 8,
+      style = 'normal',
+    }: TextOptions = {}
+  ): void {
+    // matplotlib aligns text by a line box [baseline - A, baseline + D] with the font's typographic
+    // ascent and descent (Inter: A = 0.969 em, D = 0.241 em, measured against matplotlib 3.11);
+    // browsers use other baselines. Put the alphabetic baseline where matplotlib puts it, so that
+    // text lands on the same pixels.
+    const A = 0.96875;
+    const D = 0.2412;
+    const fs = size * PT;
+    const X = this.X(x);
+    const Y = this.Y(y);
+    const baseline = Y + { center: (A - D) / 2, top: A, bottom: -D }[va] * fs;
+    this.push(
+      zorder,
+      'text',
+      {
+        x: X,
+        y: round(baseline, 2),
+        'font-size': round(fs, 2),
+        fill: colour,
+        'font-family': FONT,
+        'text-anchor': { left: 'start', center: 'middle', right: 'end' }[ha],
+        'font-weight': weight === 'bold' ? 700 : null,
+        'font-style': style === 'italic' ? 'italic' : null,
+        transform: rotation ? `rotate(${-rotation} ${X} ${Y})` : null,
+      },
+      s
+    );
+  }
+
+  public line(
+    xs: readonly number[],
+    ys: readonly number[],
+    { colour, lw = 1, dashes = null, zorder = 3, capstyle = 'butt' }: LineOptions
+  ): void {
+    this.push(zorder, 'polyline', {
+      points: xs.map((x, k) => `${this.X(x)},${this.Y(ys[k])}`).join(' '),
+      fill: 'none',
+      stroke: colour,
+      'stroke-width': round(lw * PT, 2),
+      'stroke-linecap': capstyle,
+      'stroke-linejoin': 'round',
+      'stroke-dasharray': dashes ? dashes.map((d) => round(d * lw * PT, 2)).join(' ') : null,
+    });
+  }
+
+  public rect(
+    x: number,
+    y: number,
+    w: number,
+    h: number,
+    {
+      face = 'none',
+      edge = 'none',
+      lw = 1,
+      zorder = 1,
+      rounding = 0,
+      hatch = null,
+      dashes = null,
+    }: RectOptions = {}
+  ): void {
+    if (hatch) {
+      const id = this.hatchPattern(hatch);
+      this.rect(x, y, w, h, { face: `url(#${id})`, zorder: zorder + 0.001 });
+    }
+    this.push(zorder, 'rect', {
+      x: this.X(x),
+      y: this.Y(y + h),
+      width: round(w * IN, 2),
+      height: round(h * IN, 2),
+      fill: face,
+      stroke: edge,
+      'stroke-width': edge === 'none' ? null : round(lw * PT, 2),
+      rx: rounding ? round(rounding * IN, 2) : null,
+      'stroke-dasharray': dashes ? dashes.map((d) => round(d * lw * PT, 2)).join(' ') : null,
+    });
+  }
+
+  public circle(
+    x: number,
+    y: number,
+    r: number,
+    { face, edge, lw = 1, zorder = 4 }: CircleOptions
+  ): void {
+    this.push(zorder, 'circle', {
+      cx: this.X(x),
+      cy: this.Y(y),
+      r: round(r * IN, 2),
+      fill: face,
+      stroke: edge,
+      'stroke-width': lw ? round(lw * PT, 2) : null,
+    });
+  }
+
+  public roundedSquare(
+    x: number,
+    y: number,
+    half: number,
+    { face, edge, lw = 1, zorder = 4 }: CircleOptions
+  ): void {
+    this.rect(x - half, y - half, 2 * half, 2 * half, {
+      face,
+      edge,
+      lw,
+      zorder,
+      rounding: 0.3 * half,
+    });
+  }
+
+  public diamond(
+    x: number,
+    y: number,
+    half: number,
+    { filled, colour, zorder = 6 }: DiamondOptions
+  ): void {
+    const p = [
+      [x - half, y],
+      [x, y + half],
+      [x + half, y],
+      [x, y - half],
+    ];
+    this.push(zorder, 'polygon', {
+      points: p.map(([a, b]) => `${this.X(a)},${this.Y(b)}`).join(' '),
+      fill: filled ? colour : PAL.background,
+      stroke: colour,
+      'stroke-width': round(PT, 2),
+    });
+  }
+
+  /** Appends the definitions and the elements, in z-order, to an svg element. */
+  public flush(svg: Element): void {
+    if (this.defs.length) {
+      const defs = document.createElementNS(NS, 'defs');
+      this.defs.forEach((pattern) => defs.appendChild(pattern));
+      svg.appendChild(defs);
+    }
+    [...this.items].sort((a, b) => a.z - b.z || a.i - b.i).forEach(({ el }) => svg.appendChild(el));
+  }
+
+  private setAttributes(el: Element, attrs: SvgAttributes): void {
+    for (const [key, value] of Object.entries(attrs)) {
+      if (value !== null && value !== undefined) {
+        el.setAttribute(key, String(value));
+      }
+    }
+  }
+}
