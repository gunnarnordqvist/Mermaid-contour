 grammar ContourGrammar
 import "../common/common";
 
+// Contour: the six standard views (V1 to V6) of a landscape of AI uses, drawn from a model.
+// Statements are kept in source order in `statements`; the semantic checks (enumerations, ranges,
+// required attributes, duplicate ids, panels per view) are made by the diagram's parser.
 entry Contour:
   NEWLINE*
   "contour-beta"
   (
     TitleAndAccessibilities
-    | units+=ContourUnit
+    | statements+=ContourStatement
     | NEWLINE
   )*
 ;
 
+ContourStatement:
+  ContourView
+  | ContourSubtitle
+  | ContourFooter
+  | ContourPanel
+  | ContourUnit
+  | ContourAction
+  | ContourSupplier
+;
+
+ContourView:
+  "view" name=ID EOL
+;
+
+// Free text cannot be lexed as a rest-of-line terminal without breaking the other rules,
+// so subtitle and footer take a quoted string.
+ContourSubtitle:
+  "subtitle" text=STRING EOL
+;
+
+ContourFooter:
+  "footer" text=STRING EOL
+;
+
+ContourPanel:
+  "panel" name=STRING EOL
+;
+
 ContourUnit:
-  "unit" id=ID name=STRING (attrs+=ContourAttr)* EOL
+  "unit" id=ContourId name=STRING (attrs+=ContourAttr)* EOL
+;
+
+ContourAction:
+  "action" name=STRING level=INT EOL
+;
+
+ContourSupplier:
+  "supplier" id=ContourId label=STRING (location=STRING)? (attrs+=ContourAttr)* EOL
 ;
 
 ContourAttr:
   key=ID '=' value=ContourValue
 ;
 
-ContourValue returns string: ID | INT;
+// A single word or a comma separated list of words (kinds, suppliers).
+// `supplier` is a keyword and also a value (operated_by=supplier).
+ContourValue returns string:
+  ContourWord (',' ContourWord)*
+;
+
+ContourWord returns string:
+  ID | INT | 'supplier'
+;
+
+ContourId returns string:
+  ID | INT
+;
