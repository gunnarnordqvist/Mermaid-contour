+// ---------------------------------------------------------------------------
+// Helpers of the decisions (V4) and evidence (V5) views
+// ---------------------------------------------------------------------------
+/** Units by descending level, then by id. */
+export const rowOrder = (units: readonly ContourUnit[]): ContourUnit[] =>
+  [...units].sort((a, b) => b.level - a.level || compareStrings(a.id, b.id));
+
+export function rowLabel(cv: Canvas, y: number, u: ContourUnit, nameRight: number): void {
+  drawMiniMark(cv, MARGIN + 0.1, y, u);
+  cv.text(MARGIN + 0.28, y, u.id, { weight: 'bold' });
+  cv.text(MARGIN + 1.02, y, `${u.reversibility} ${u.reach}`, { colour: PAL.muted });
+  const nameX = MARGIN + 1.5;
+  cv.text(nameX, y, truncateToWidth(u.name, nameRight - nameX), { colour: PAL.muted });
+}
+
+export function drawLevelBar(
+  cv: Canvas,
+  gridLeft: number,
+  cw: number,
+  y: number,
+  level: number,
+  thickness: number,
+  outline: string | null,
+  lw: number
+): void {
+  for (let k = 0; k <= level; k++) {
+    cv.rect(gridLeft + k * cw, y - thickness / 2, cw, thickness, { face: PAL.ramp[k], zorder: 2 });
+  }
+  if (outline) {
+    cv.rect(gridLeft, y - thickness / 2, (level + 1) * cw, thickness, {
+      face: 'none',
+      edge: outline,
+      lw,
+      zorder: 2.5,
+    });
+  }
+}
+
+/** Break items into rows no wider than maxW (used by the supply view's boxes). */
+export function flow<T>(
+  items: readonly T[],
+  maxW: number,
+  widthOf: (item: T) => number,
+  gap: number
+): T[][] {
+  const rows: T[][] = [[]];
+  let used = 0;
+  for (const it of items) {
+    const w = widthOf(it);
+    if (rows[rows.length - 1].length && used + gap + w > maxW) {
+      rows.push([]);
+      used = 0;
+    }
+    if (rows[rows.length - 1].length) {
+      used += gap;
+    }
+    rows[rows.length - 1].push(it);
+    used += w;
+  }
+  return rows;
+}
+
+/** Fills the canvas with the background colour; every view starts with this. */
+export function drawBackground(cv: Canvas): void {
+  cv.push(-1, 'rect', {
+    x: 0,
+    y: 0,
+    width: cv.width * IN,
+    height: cv.height * IN,
+    fill: PAL.background,
+  });
+}
+
+/** The comparison used for ids throughout, matching the JS and Python string order. */
+export { compareStrings };
