+import { describe, expect, it } from 'vitest';
+import type { Canvas } from '../canvas.js';
+import { PAL } from '../common.js';
+import type { ContourModel, ContourUnit, Evidence, EvidenceKind } from '../types.js';
+import { layoutEvidence } from './evidence.js';
+
+const unit = (id: string, evidence: Evidence, kinds: EvidenceKind[], level = 2): ContourUnit => ({
+  id,
+  name: `Unit ${id}`,
+  level,
+  reversibility: 'R1',
+  reach: 'S',
+  mode: 3,
+  identity: 'person',
+  policy: 'none',
+  tier: 'T0',
+  evidence,
+  status: 'active',
+  kinds,
+  hosting: 'own-premises',
+  operatedBy: 'self',
+  suppliers: [],
+  actions: [],
+});
+
+const model = (units: ContourUnit[]): ContourModel => ({
+  view: 'evidence',
+  title: 'Evidence',
+  subtitle: '',
+  footer: [],
+  panels: [{ name: 'Test', units }],
+  suppliers: [],
+});
+
+const svgOf = (cv: Canvas): Element => {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  cv.flush(svg);
+  return svg;
+};
+
+const texts = (svg: Element): (string | null)[] =>
+  [...svg.querySelectorAll('text')].map((t) => t.textContent);
+
+/** The cells of the grid: rects of the cell height, 0.3 - 2 * 0.055 inches. */
+const cells = (svg: Element): Element[] =>
+  [...svg.querySelectorAll('rect')].filter((r) => r.getAttribute('height') === '19');
+
+describe('contour evidence view (V5)', () => {
+  it('draws automatic kinds as filled cells', () => {
+    const svg = svgOf(layoutEvidence(model([unit('A', 'automatic', ['logs', 'tests', 'gates'])])));
+    const filled = cells(svg).filter((r) => r.getAttribute('fill') === PAL.automatic);
+    expect(filled).toHaveLength(3);
+    expect(svg.querySelectorAll('pattern')).toHaveLength(0);
+  });
+
+  it('draws an attested kind as a hatched cell', () => {
+    const svg = svgOf(layoutEvidence(model([unit('A', 'attested', ['attestations'])])));
+    const hatched = cells(svg).filter((r) => r.getAttribute('fill')?.startsWith('url(#'));
+    expect(hatched).toHaveLength(1);
+    const outlined = cells(svg).filter((r) => r.getAttribute('stroke') === PAL.attested);
+    expect(outlined).toHaveLength(1);
+  });
+
+  it('gives the red none cell to evidence none, and only then', () => {
+    const none = svgOf(layoutEvidence(model([unit('A', 'none', [])])));
+    expect(texts(none)).toContain('none');
+    expect(cells(none).filter((r) => r.getAttribute('stroke') === PAL.warning)).toHaveLength(1);
+    expect(texts(none).some((t) => t?.includes('kinds not recorded'))).toBe(false);
+    const other = svgOf(layoutEvidence(model([unit('A', 'automatic', ['logs'])])));
+    expect(texts(other)).not.toContain('none');
+    expect(cells(other).filter((r) => r.getAttribute('stroke') === PAL.warning)).toHaveLength(0);
+  });
+
+  it('notes that kinds are not recorded for a unit with evidence but no kinds', () => {
+    const svg = svgOf(layoutEvidence(model([unit('A', 'attested', [])])));
+    const note = [...svg.querySelectorAll('text')].find((t) =>
+      t.textContent?.includes('attested: kinds not recorded')
+    );
+    expect(note).toBeDefined();
+    expect(note?.getAttribute('font-style')).toBe('italic');
+    expect(cells(svg)).toHaveLength(0);
+  });
+
+  it('draws the baseline solid for automatic and dashed for attested', () => {
+    const baseline = (evidence: Evidence, kinds: EvidenceKind[], colour: string) =>
+      [...svgOf(layoutEvidence(model([unit('A', evidence, kinds)]))).querySelectorAll('polyline')]
+        .filter(
+          (p) => p.getAttribute('stroke') === colour && p.getAttribute('stroke-width') === '2.22'
+        )
+        .map((p) => p.getAttribute('stroke-dasharray'));
+    const automatic = baseline('automatic', ['logs'], PAL.automatic);
+    expect(automatic.length).toBeGreaterThan(0);
+    expect(automatic[0]).toBeNull();
+    const attested = baseline('attested', ['attestations'], PAL.attested);
+    expect(attested.some((d) => d !== null && d !== '')).toBe(true);
+    expect(baseline('none', [], PAL.automatic)).toHaveLength(0);
+  });
+
+  it('defines one hatch pattern per canvas however many cells are hatched', () => {
+    const units = ['A', 'B', 'C'].map((id) => unit(id, 'attested', ['attestations']));
+    const svg = svgOf(layoutEvidence(model(units)));
+    expect(cells(svg).filter((r) => r.getAttribute('fill')?.startsWith('url(#'))).toHaveLength(3);
+    expect(svg.querySelectorAll('pattern')).toHaveLength(1);
+  });
+
+  it('wraps the column headers to the column width', () => {
+    const svg = svgOf(layoutEvidence(model([unit('A', 'automatic', ['logs'])])));
+    const all = texts(svg);
+    expect(all).toContain('Logs');
+    expect(all).toContain('Attestations');
+    expect(all).not.toContain('Gates and policies as code');
+    expect(all).not.toContain('Tests and evaluations');
+    expect(all).toContain('Tests and');
+  });
+
+  it('grows the canvas with the number of units', () => {
+    const few = layoutEvidence(model([unit('A', 'automatic', ['logs'])]));
+    const many = layoutEvidence(
+      model(
+        Array.from({ length: 40 }, (_, i) =>
+          unit(`U${String(i).padStart(2, '0')}`, 'automatic', ['logs'])
+        )
+      )
+    );
+    expect(few.width).toBe(11);
+    expect(few.height).toBe(7.5);
+    expect(many.width).toBe(11);
+    expect(many.height).toBeGreaterThan(7.5);
+    expect(many.height * 2).toBe(Math.round(many.height * 2));
+  });
+
+  it('gives an empty view, not an error, for a view without units', () => {
+    const svg = svgOf(layoutEvidence(model([])));
+    expect(cells(svg)).toHaveLength(0);
+    expect(texts(svg)).toContain('Logs');
+    const noPanel = layoutEvidence({ ...model([]), panels: [] });
+    expect(noPanel.height).toBe(7.5);
+  });
+});
