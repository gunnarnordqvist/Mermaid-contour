-import type { Canvas } from '../canvas.js';
+// cspell:ignore zorder
+import { Canvas } from '../canvas.js';
+import {
+  AUTOMATIC_KINDS,
+  COL_LABEL_HEIGHT,
+  EVIDENCE_COLUMNS,
+  FIG_H,
+  FIG_W,
+  FOOTER_BAND,
+  LABEL_AREA,
+  LEGEND_BOTTOM,
+  LEGEND_TOP,
+  LEGEND_WIDTH,
+  MARGIN,
+  MINI_RADIUS,
+  PAL,
+  ROW_PITCH_EVIDENCE,
+  TITLE_BAND,
+  drawBackground,
+  drawLegend,
+  drawTitleFooter,
+  rowLabel,
+  rowOrder,
+  wrapToWidth,
+} from '../common.js';
 import type { ContourModel } from '../types.js';
 
-/** V5 The evidence view. */
-export function layoutEvidence(_model: ContourModel): Canvas {
-  throw new Error('contour: view evidence is not implemented');
+/** V5 The evidence view: one row per unit, one column per kind of evidence. The page grows with the rows. */
+export function layoutEvidence(model: ContourModel): Canvas {
+  const units = rowOrder(model.panels[0]?.units ?? []);
+  const needed =
+    TITLE_BAND + COL_LABEL_HEIGHT + 0.12 + units.length * ROW_PITCH_EVIDENCE + 0.15 + FOOTER_BAND;
+  const cv = new Canvas(FIG_W, Math.max(FIG_H, Math.ceil(needed * 2) / 2));
+  drawBackground(cv);
+  drawTitleFooter(cv, model);
+  const gridLeft = MARGIN + LABEL_AREA;
+  const gridRight = cv.width - MARGIN - LEGEND_WIDTH - 0.3;
+  const cw = (gridRight - gridLeft) / EVIDENCE_COLUMNS.length;
+  const top = cv.height - TITLE_BAND - COL_LABEL_HEIGHT - 0.12;
+  EVIDENCE_COLUMNS.forEach(([, name], i) => {
+    const cx = gridLeft + (i + 0.5) * cw;
+    wrapToWidth(name, cw - 0.08).forEach((t, k) => {
+      cv.text(cx, top + 0.46 - k * 0.15, t, { ha: 'center', weight: 'bold' });
+    });
+  });
+  const bottom = top - units.length * ROW_PITCH_EVIDENCE;
+  for (let i = 0; i <= EVIDENCE_COLUMNS.length; i++) {
+    cv.line([gridLeft + i * cw, gridLeft + i * cw], [bottom, top], {
+      colour: PAL.grid,
+      lw: 0.6,
+      zorder: 1,
+    });
+  }
+  cv.line([MARGIN, gridRight], [top, top], { colour: PAL.grid, lw: 0.8, zorder: 1 });
+  let y = top;
+  const insetX = 0.1;
+  const insetY = 0.055;
+  for (const u of units) {
+    const rowY = y - ROW_PITCH_EVIDENCE / 2;
+    rowLabel(cv, rowY, u, gridLeft - 0.1);
+    const baseY = rowY - MINI_RADIUS - 0.045;
+    if (u.evidence === 'automatic') {
+      cv.line([MARGIN + 0.02, MARGIN + 0.18], [baseY, baseY], { colour: PAL.automatic, lw: 1.6 });
+    } else if (u.evidence === 'attested') {
+      cv.line([MARGIN + 0.02, MARGIN + 0.18], [baseY, baseY], {
+        colour: PAL.attested,
+        lw: 1.6,
+        dashes: [3, 2],
+      });
+    }
+    EVIDENCE_COLUMNS.forEach(([kind], i) => {
+      const x0 = gridLeft + i * cw;
+      const cellY = rowY - ROW_PITCH_EVIDENCE / 2 + insetY;
+      const cellH = ROW_PITCH_EVIDENCE - 2 * insetY;
+      if (kind === 'none') {
+        if (u.evidence === 'none') {
+          cv.rect(x0 + insetX, cellY, cw - 2 * insetX, cellH, {
+            face: 'none',
+            edge: PAL.warning,
+            lw: 1.0,
+            zorder: 2,
+          });
+          cv.text(x0 + cw / 2, rowY, 'none', {
+            colour: PAL.warning,
+            ha: 'center',
+            weight: 'bold',
+            zorder: 5,
+          });
+        }
+        return;
+      }
+      if (!u.kinds.includes(kind)) {
+        return;
+      }
+      if (AUTOMATIC_KINDS.includes(kind)) {
+        cv.rect(x0 + insetX, cellY, cw - 2 * insetX, cellH, { face: PAL.automatic, zorder: 2 });
+      } else {
+        cv.rect(x0 + insetX, cellY, cw - 2 * insetX, cellH, {
+          face: PAL.background,
+          edge: PAL.attested,
+          lw: 0.8,
+          hatch: PAL.attested,
+          zorder: 2,
+        });
+      }
+    });
+    if (!u.kinds.length && u.evidence !== 'none') {
+      cv.text(gridLeft + 2 * cw, rowY, `${u.evidence}: kinds not recorded`, {
+        colour: PAL.muted,
+        ha: 'center',
+        style: 'italic',
+      });
+    }
+    y -= ROW_PITCH_EVIDENCE;
+    cv.line([MARGIN, gridRight], [y, y], { colour: PAL.grid, lw: 0.6, zorder: 1 });
+  }
+  drawLegend(
+    cv,
+    cv.width - MARGIN - LEGEND_WIDTH,
+    cv.height - LEGEND_TOP,
+    LEGEND_BOTTOM,
+    LEGEND_WIDTH
+  );
+  return cv;
 }
