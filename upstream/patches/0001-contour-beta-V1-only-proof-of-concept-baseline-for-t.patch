@@ -0,0 +1,40 @@
+import { describe, expect, it } from 'vitest';
+import { parser } from './parser.js';
+import { ContourDB } from './db.js';
+
+const parse = async (input: string) => {
+  const db = new ContourDB();
+  parser.parser = { yy: db } as never;
+  await parser.parse(input);
+  return db;
+};
+
+describe('contour', () => {
+  it('parses a title and units', async () => {
+    const db = await parse(`contour-beta
+      title Mini landscape
+      unit NR-BT "Benefits triage" level=0 rev=R3 reach=XL mode=4 identity=own policy=enforced tier=T2 evidence=automatic
+      unit NR-SA "Staff assistant" level=1 rev=R1 reach=L mode=0
+    `);
+    expect(db.getDiagramTitle()).toBe('Mini landscape');
+    const [a, b] = db.getUnits();
+    expect(a).toMatchObject({ id: 'NR-BT', level: 0, reversibility: 3, reach: 'XL', mode: 4, identity: 'own', policy: 'enforced', tier: 'T2', evidence: 'automatic' });
+    // absences stay absences
+    expect(b).toMatchObject({ identity: 'person', policy: 'none', tier: 'T0', evidence: 'none' });
+  });
+
+  it('rejects a missing required attribute', async () => {
+    await expect(parse(`contour-beta\n unit A "a" level=0 rev=R1 reach=S`)).rejects.toThrow(/lacks the required attribute mode/);
+  });
+
+  it('rejects values outside the scale', async () => {
+    await expect(parse(`contour-beta\n unit A "a" level=5 rev=R1 reach=S mode=0`)).rejects.toThrow(/level=5/);
+    await expect(parse(`contour-beta\n unit A "a" level=0 rev=R9 reach=S mode=0`)).rejects.toThrow(/rev=R9/);
+  });
+
+  it('rejects a duplicate id and an unknown attribute', async () => {
+    const u = 'level=0 rev=R1 reach=S mode=0';
+    await expect(parse(`contour-beta\n unit A "a" ${u}\n unit A "b" ${u}`)).rejects.toThrow(/twice/);
+    await expect(parse(`contour-beta\n unit A "a" ${u} colour=red`)).rejects.toThrow(/unknown attribute/);
+  });
+});
diff --git a/packages/mermaid/src/diagrams/contour/db.ts b/packages/mermaid/src/diagrams/contour/db.ts
