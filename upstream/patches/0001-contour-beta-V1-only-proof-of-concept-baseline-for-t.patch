diff --git a/packages/mermaid/src/diagrams/contour/parser.ts b/packages/mermaid/src/diagrams/contour/parser.ts
new file mode 100644
index 0000000..1709b6d
--- /dev/null
+++ b/packages/mermaid/src/diagrams/contour/parser.ts
@@ -0,0 +1,78 @@
+import type { Contour } from '@mermaid-js/parser';
+import { parse } from '@mermaid-js/parser';
+import type { ParserDefinition } from '../../diagram-api/types.js';
+import { log } from '../../logger.js';
+import { populateCommonDb } from '../common/populateCommonDb.js';
+import { ContourDB } from './db.js';
+import type { ContourUnit } from './types.js';
+import { EVIDENCE, IDENTITY, POLICY, REACH, REVERSIBILITY, TIERS } from './types.js';
+
+const oneOf = <T extends string>(unit: string, key: string, value: string, allowed: readonly T[]) => {
+  if (!(allowed as readonly string[]).includes(value)) {
+    throw new Error(`Contour unit ${unit}: ${key}=${value} is not one of ${allowed.join(', ')}.`);
+  }
+  return value as T;
+};
+
+const int = (unit: string, key: string, value: string, min: number, max: number) => {
+  const n = Number(value);
+  if (!Number.isInteger(n) || n < min || n > max) {
+    throw new Error(`Contour unit ${unit}: ${key}=${value} must be an integer from ${min} to ${max}.`);
+  }
+  return n;
+};
+
+const populate = (ast: Contour, db: ContourDB) => {
+  populateCommonDb(ast, db);
+  for (const { id, name, attrs } of ast.units) {
+    const a: Record<string, string> = {};
+    for (const { key, value } of attrs) {
+      if (key in a) {
+        throw new Error(`Contour unit ${id}: ${key} is given twice.`);
+      }
+      a[key] = String(value);
+    }
+    for (const required of ['level', 'rev', 'reach', 'mode']) {
+      if (!(required in a)) {
+        throw new Error(`Contour unit ${id} lacks the required attribute ${required}.`);
+      }
+    }
+    const known = ['level', 'rev', 'reach', 'mode', 'identity', 'policy', 'tier', 'evidence'];
+    for (const key of Object.keys(a)) {
+      if (!known.includes(key)) {
+        throw new Error(`Contour unit ${id}: unknown attribute ${key}. Known: ${known.join(', ')}.`);
+      }
+    }
+    // Absences are drawn as absences: an unknown value is "none", not a guess.
+    const unit: ContourUnit = {
+      id,
+      name,
+      level: int(id, 'level', a.level, 0, 4),
+      reversibility: REVERSIBILITY.indexOf(oneOf(id, 'rev', a.rev, REVERSIBILITY)) + 1,
+      reach: oneOf(id, 'reach', a.reach, REACH),
+      mode: int(id, 'mode', a.mode, 0, 5),
+      identity: oneOf(id, 'identity', a.identity ?? 'person', IDENTITY),
+      policy: oneOf(id, 'policy', a.policy ?? 'none', POLICY),
+      tier: oneOf(id, 'tier', a.tier ?? 'T0', TIERS),
+      evidence: oneOf(id, 'evidence', a.evidence ?? 'none', EVIDENCE),
+    };
+    log.debug('Contour unit', unit);
+    db.addUnit(unit);
+  }
+};
+
+export const parser: ParserDefinition = {
+  // @ts-expect-error - ContourDB is not assignable to DiagramDB
+  parser: { yy: undefined },
+  parse: async (input: string): Promise<void> => {
+    const ast: Contour = await parse('contour', input);
+    const db = parser.parser?.yy;
+    if (!(db instanceof ContourDB)) {
+      throw new Error(
+        'parser.parser?.yy was not a ContourDB. This is due to a bug within Mermaid, please report this issue at https://github.com/mermaid-js/mermaid/issues.'
+      );
+    }
+    log.debug(ast);
+    populate(ast, db);
+  },
+};
diff --git a/packages/mermaid/src/diagrams/contour/renderer.ts b/packages/mermaid/src/diagrams/contour/renderer.ts
new file mode 100644
index 0000000..362d48e
--- /dev/null
+++ b/packages/mermaid/src/diagrams/contour/renderer.ts
@@ -0,0 +1,109 @@
+import type { Diagram } from '../../Diagram.js';
+import type { DiagramRenderer, DrawDefinition, SVG } from '../../diagram-api/types.js';
+import { selectSvgElement } from '../../rendering-util/selectSvgElement.js';
+import { configureSvgSize } from '../../setupGraphViewbox.js';
+import type { ContourDB, ContourUnit } from './types.js';
+
+const LEVELS = ['Advisory', 'Assisted', 'Supervised', 'Bounded', 'Autonomous'];
+const ROWS = ['R1 Reversible at once', 'R2', 'R3', 'R4 Irreversible'];
+const HALF_SIZE = { S: 7, M: 10, L: 14, XL: 19 };
+const MODE_COLOURS = ['#7890B0', '#3B82F6', '#40A090', '#C88000', '#1B3A7A', '#B2367D'];
+
+const LEFT = 130;
+const TOP = 50;
+const CELL_W = 120;
+const CELL_H = 90;
+const WIDTH = LEFT + CELL_W * 5 + 10;
+const HEIGHT = TOP + CELL_H * 4 + 10;
+
+const draw: DrawDefinition = (_text, id, _version, diagram: Diagram) => {
+  const db = diagram.db as ContourDB;
+  const svg: SVG = selectSvgElement(id);
+  svg.attr('viewBox', `0 0 ${WIDTH} ${HEIGHT}`);
+  configureSvgSize(svg, HEIGHT, WIDTH, true);
+
+  svg
+    .append('text')
+    .attr('x', LEFT)
+    .attr('y', 22)
+    .attr('class', 'contourTitle')
+    .text(db.getDiagramTitle());
+
+  LEVELS.forEach((name, c) => {
+    svg
+      .append('text')
+      .attr('x', LEFT + CELL_W * c + CELL_W / 2)
+      .attr('y', TOP - 8)
+      .attr('text-anchor', 'middle')
+      .attr('class', 'contourAxis')
+      .text(`Level ${c} ${name}`);
+  });
+  ROWS.forEach((name, r) => {
+    svg
+      .append('text')
+      .attr('x', LEFT - 8)
+      .attr('y', TOP + CELL_H * r + CELL_H / 2)
+      .attr('text-anchor', 'end')
+      .attr('class', 'contourAxis')
+      .text(name);
+  });
+  for (let c = 0; c < 5; c++) {
+    for (let r = 0; r < 4; r++) {
+      svg
+        .append('rect')
+        .attr('x', LEFT + CELL_W * c)
+        .attr('y', TOP + CELL_H * r)
+        .attr('width', CELL_W)
+        .attr('height', CELL_H)
+        .attr('class', c === 4 && r >= 2 ? 'contourEmptyCorner' : 'contourCell');
+    }
+  }
+
+  const cells = new Map<string, ContourUnit[]>();
+  for (const u of db.getUnits()) {
+    const key = `${u.level},${u.reversibility}`;
+    cells.set(key, [...(cells.get(key) ?? []), u]);
+  }
+  for (const units of cells.values()) {
+    units.forEach((u, i) => {
+      const x = LEFT + CELL_W * u.level + (CELL_W / (units.length + 1)) * (i + 1);
+      const y = TOP + CELL_H * (u.reversibility - 1) + CELL_H / 2;
+      drawMark(svg, u, x, y);
+    });
+  }
+};
+
+const drawMark = (svg: SVG, u: ContourUnit, x: number, y: number) => {
+  const s = HALF_SIZE[u.reach];
+  const g = svg.append('g').attr('data-unit', u.id);
+  const fill = MODE_COLOURS[u.mode];
+  if (u.identity === 'own') {
+    g.append('rect')
+      .attr('x', x - s).attr('y', y - s).attr('width', 2 * s).attr('height', 2 * s)
+      .attr('rx', 4).attr('fill', fill).attr('class', 'contourMark');
+  } else {
+    g.append('circle').attr('cx', x).attr('cy', y).attr('r', s).attr('fill', fill).attr('class', 'contourMark');
+  }
+  g.append('text').attr('x', x).attr('y', y + 4).attr('text-anchor', 'middle')
+    .attr('class', 'contourDigit').text(u.mode);
+  if (u.policy !== 'none') {
+    g.append('path')
+      .attr('d', `M${x + s} ${y - s - 7} l6 6 l-6 6 l-6 -6 z`)
+      .attr('fill', u.policy === 'enforced' ? '#111827' : 'none')
+      .attr('class', 'contourDiamond');
+  }
+  if (u.tier !== 'T0') {
+    g.append('text').attr('x', x - s - 4).attr('y', y - s).attr('text-anchor', 'end')
+      .attr('class', 'contourSeat').text(u.tier);
+  }
+  if (u.evidence !== 'none') {
+    g.append('line')
+      .attr('x1', x - s).attr('x2', x + s).attr('y1', y + s + 4).attr('y2', y + s + 4)
+      .attr('stroke-dasharray', u.evidence === 'attested' ? '3 2' : null)
+      .attr('class', 'contourBaseline');
+  }
+  g.append('text').attr('x', x).attr('y', y + s + 16).attr('text-anchor', 'middle')
+    .attr('class', 'contourId').text(u.id);
+};
+
+export const renderer: DiagramRenderer = { draw };
