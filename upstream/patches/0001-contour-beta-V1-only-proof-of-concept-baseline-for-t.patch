+import type { DiagramDBBase } from '../../diagram-api/types.js';
+
+export const REVERSIBILITY = ['R1', 'R2', 'R3', 'R4'] as const;
+export const REACH = ['S', 'M', 'L', 'XL'] as const;
+export const IDENTITY = ['person', 'own'] as const;
+export const POLICY = ['enforced', 'planned', 'none'] as const;
+export const TIERS = ['T0', 'T1', 'T2', 'T3', 'T4'] as const;
+export const EVIDENCE = ['automatic', 'attested', 'none'] as const;
+
+export interface ContourUnit {
+  id: string;
+  name: string;
+  /** Autonomy level, 0 (Advisory) to 4 (Autonomous). */
+  level: number;
+  /** Reversibility tier, 1 (R1) to 4 (R4). */
+  reversibility: number;
+  reach: (typeof REACH)[number];
+  /** Usage mode, 0 (Ambient AI) to 5 (Autonomous production agents). */
+  mode: number;
+  identity: (typeof IDENTITY)[number];
+  policy: (typeof POLICY)[number];
+  tier: (typeof TIERS)[number];
+  evidence: (typeof EVIDENCE)[number];
+}
+
+export interface ContourDB extends DiagramDBBase<Record<string, never>> {
+  addUnit: (unit: ContourUnit) => void;
+  getUnits: () => ContourUnit[];
+}
