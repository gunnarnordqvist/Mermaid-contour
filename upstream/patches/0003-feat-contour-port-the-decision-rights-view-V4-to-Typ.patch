+import { describe, expect, it } from 'vitest';
+import { ACTION_PITCH, DIAMOND_HALF, LEVEL_NAMES, PAL, ROW_PITCH } from '../common.js';
+import type { ContourModel, ContourUnit } from '../types.js';
+import { layoutDecisions } from './decisions.js';
+
+const NS = 'http://www.w3.org/2000/svg';
+
+const unit = (id: string, over: Partial<ContourUnit> = {}): ContourUnit => ({
+  id,
+  name: `Unit ${id}`,
+  level: 1,
+  reversibility: 'R1',
+  reach: 'S',
+  mode: 2,
+  identity: 'person',
+  policy: 'none',
+  tier: 'T0',
+  evidence: 'none',
+  status: 'active',
+  kinds: [],
+  hosting: 'unknown',
+  operatedBy: 'self',
+  suppliers: [],
+  actions: [],
+  ...over,
+});
+
+const modelOf = (units: ContourUnit[]): ContourModel => ({
+  view: 'decisions',
+  title: 'Decisions',
+  subtitle: '',
+  footer: [],
+  panels: [{ name: 'P', units }],
+  suppliers: [],
+});
+
+const draw = (units: ContourUnit[]) => {
+  const cv = layoutDecisions(modelOf(units));
+  const svg = document.createElementNS(NS, 'svg');
+  cv.flush(svg);
+  return { cv, svg };
+};
+
+const texts = (svg: Element) => [...svg.querySelectorAll('text')].map((t) => t.textContent ?? '');
+const rectsWithFill = (svg: Element, fill: string) =>
+  [...svg.querySelectorAll('rect')].filter((r) => r.getAttribute('fill') === fill);
+const rectsWithStroke = (svg: Element, stroke: string) =>
+  [...svg.querySelectorAll('rect')].filter((r) => r.getAttribute('stroke') === stroke);
+
+describe('contour decisions view (V4)', () => {
+  it('sorts the rows by descending level, then by id', () => {
+    const { svg } = draw([
+      unit('B', { level: 2 }),
+      unit('C', { level: 3 }),
+      unit('A', { level: 2 }),
+      unit('D', { level: 0 }),
+    ]);
+    const ids = texts(svg).filter((t) => ['A', 'B', 'C', 'D'].includes(t));
+    expect(ids).toEqual(['C', 'A', 'B', 'D']);
+  });
+
+  it('labels the five level columns', () => {
+    const { svg } = draw([unit('A')]);
+    const all = texts(svg);
+    for (const name of LEVEL_NAMES) {
+      const [a, b, ...rest] = name.split(' ');
+      expect(all).toContain(`${a} ${b}`);
+      expect(all).toContain(rest.join(' '));
+    }
+  });
+
+  it('shades the cell of Level 4 for R3 and R4 rows only', () => {
+    const none = draw([unit('A', { reversibility: 'R1' }), unit('B', { reversibility: 'R2' })]);
+    expect(rectsWithFill(none.svg, PAL.emptyCorner)).toHaveLength(0);
+    const some = draw([
+      unit('A', { reversibility: 'R3' }),
+      unit('B', { reversibility: 'R4' }),
+      unit('C', { reversibility: 'R2' }),
+    ]);
+    expect(rectsWithFill(some.svg, PAL.emptyCorner)).toHaveLength(2);
+  });
+
+  it('outlines Level 3 without an enforced policy point in red, and nothing else', () => {
+    const red = (u: ContourUnit) => rectsWithStroke(draw([u]).svg, PAL.warning).length;
+    expect(red(unit('A', { level: 3, policy: 'none' }))).toBe(1);
+    expect(red(unit('A', { level: 3, policy: 'planned' }))).toBe(1);
+    expect(red(unit('A', { level: 3, policy: 'enforced' }))).toBe(0);
+    expect(red(unit('A', { level: 2, policy: 'none' }))).toBe(0);
+  });
+
+  it('gives each unit a block of one row plus one pitch per action', () => {
+    const pitchBetweenRows = (actions: [string, number][]) => {
+      const { svg } = draw([unit('A', { level: 3, actions }), unit('B', { level: 0 })]);
+      const y = (id: string) =>
+        Number(
+          [...svg.querySelectorAll('text')].find((t) => t.textContent === id)?.getAttribute('y')
+        );
+      return (y('B') - y('A')) / 100;
+    };
+    expect(pitchBetweenRows([])).toBeCloseTo(ROW_PITCH, 2);
+    expect(pitchBetweenRows([['read', 0]])).toBeCloseTo(ROW_PITCH + ACTION_PITCH, 2);
+    const three: [string, number][] = [
+      ['read', 0],
+      ['write', 1],
+      ['send', 2],
+    ];
+    expect(pitchBetweenRows(three)).toBeCloseTo(ROW_PITCH + 3 * ACTION_PITCH, 2);
+    const { svg } = draw([unit('A', { actions: three })]);
+    expect(texts(svg)).toEqual(expect.arrayContaining(['read', 'write', 'send']));
+    // each action bar is 0.05 in thin and has one segment per level up to its own: 1 + 2 + 3
+    const thin = [...svg.querySelectorAll('rect')].filter(
+      (r) => Number(r.getAttribute('height')) === 5
+    );
+    expect(thin).toHaveLength(6);
+  });
+
+  it('truncates a long unit name and a long action name with an ellipsis', () => {
+    const { svg } = draw([
+      unit('A', {
+        name: 'An extraordinarily long unit name that cannot possibly fit in the label area',
+        actions: [['A very long action class name that is far too wide for its column', 1]],
+      }),
+    ]);
+    const cut = texts(svg).filter((t) => t.endsWith('…'));
+    expect(cut).toHaveLength(2);
+    expect(cut.some((t) => t.startsWith('An extraordinarily'))).toBe(true);
+    expect(cut.some((t) => t.startsWith('A very long action'))).toBe(true);
+  });
+
+  // the legend draws a diamond and a seat of its own, so the view is compared with a bare row
+  it('draws a hollow diamond for a planned policy point and a filled one for enforced', () => {
+    const diamonds = (policy: ContourUnit['policy']) =>
+      [...draw([unit('A', { policy })]).svg.querySelectorAll('polygon')].map((p) =>
+        p.getAttribute('fill')
+      );
+    const base = diamonds('none');
+    expect(diamonds('planned')).toHaveLength(base.length + 1);
+    expect(diamonds('planned').filter((f) => f === PAL.background)).toHaveLength(
+      base.filter((f) => f === PAL.background).length + 1
+    );
+    expect(diamonds('enforced').filter((f) => f === PAL.ink)).toHaveLength(
+      base.filter((f) => f === PAL.ink).length + 1
+    );
+  });
+
+  it('draws a decision seat for tiers T1 to T4 and none for T0', () => {
+    const seats = (tier: ContourUnit['tier']) =>
+      draw([unit('A', { tier })]).svg.querySelectorAll(`circle[fill="${PAL.people}"]`).length;
+    expect(seats('T3')).toBe(seats('T0') + 1);
+    expect(seats('T1')).toBe(seats('T0') + 1);
+    expect(texts(draw([unit('A', { tier: 'T3' })]).svg)).toContain('3');
+  });
+
+  it('grows the canvas with the number of units', () => {
+    const small = draw([unit('A')]);
+    expect(small.cv.width).toBe(11);
+    expect(small.cv.height).toBe(7.5);
+    const ids = Array.from({ length: 45 }, (_, i) => `U${String(i).padStart(2, '0')}`);
+    expect(draw(ids.map((id) => unit(id))).cv.height).toBe(12.5);
+    // 45 rows and 31 action rows: 1.61 + 45 * 0.24 + 31 * 0.145 = 16.905 in, rounded up to 17
+    const withActions = ids.map((id, i) => unit(id, { actions: i < 31 ? [['read', 1]] : [] }));
+    expect(draw(withActions).cv.height).toBe(17);
+  });
+
+  it('gives an empty view, not an error, for a model without units', () => {
+    const { cv, svg } = draw([]);
+    expect(cv.height).toBe(7.5);
+    expect(texts(svg)).toContain('Level 0 Advisory'.split(' ').slice(0, 2).join(' '));
+    const noPanels = layoutDecisions({ ...modelOf([]), panels: [] });
+    expect(noPanels.height).toBe(7.5);
+  });
+});
