-import type { Canvas } from '../canvas.js';
+// cspell:ignore zorder
+import { Canvas } from '../canvas.js';
+import {
+  ACTION_PITCH,
+  COL_LABEL_HEIGHT,
+  DIAMOND_HALF,
+  FIG_H,
+  FIG_W,
+  FONT_SIZE,
+  FOOTER_BAND,
+  LABEL_AREA,
+  LEGEND_BOTTOM,
+  LEGEND_TOP,
+  LEGEND_WIDTH,
+  LEVEL_NAMES,
+  MARGIN,
+  PAL,
+  ROW_PITCH,
+  SEAT_RADIUS,
+  TITLE_BAND,
+  drawBackground,
+  drawLegend,
+  drawLevelBar,
+  drawTitleFooter,
+  redRule,
+  rowLabel,
+  rowOrder,
+  truncateToWidth,
+} from '../common.js';
 import type { ContourModel } from '../types.js';
 
-/** V4 The decision-rights view. */
-export function layoutDecisions(_model: ContourModel): Canvas {
-  throw new Error('contour: view decisions is not implemented');
+/** V4 The decision-rights view: one row per unit, with a bar to its level and one thin bar per action class. */
+export function layoutDecisions(model: ContourModel): Canvas {
+  const units = rowOrder(model.panels[0]?.units ?? []);
+  const actionCount = units.reduce((sum, u) => sum + u.actions.length, 0);
+  const needed =
+    TITLE_BAND +
+    COL_LABEL_HEIGHT +
+    units.length * ROW_PITCH +
+    actionCount * ACTION_PITCH +
+    0.15 +
+    FOOTER_BAND;
+  const cv = new Canvas(FIG_W, Math.max(FIG_H, Math.ceil(needed * 2) / 2));
+  drawBackground(cv);
+  drawTitleFooter(cv, model);
+  const gridLeft = MARGIN + LABEL_AREA;
+  const gridRight = cv.width - MARGIN - LEGEND_WIDTH - 0.3 - 0.3;
+  const cw = (gridRight - gridLeft) / 5;
+  const top = cv.height - TITLE_BAND - COL_LABEL_HEIGHT;
+  LEVEL_NAMES.forEach((name, i) => {
+    const [a, b, ...rest] = name.split(' ');
+    const cx = gridLeft + (i + 0.5) * cw;
+    cv.text(cx, top + 0.3, `${a} ${b}`, { size: FONT_SIZE + 0.5, ha: 'center', weight: 'bold' });
+    cv.text(cx, top + 0.14, rest.join(' '), { colour: PAL.muted, ha: 'center' });
+  });
+  let y = top;
+  const bottom = top - (units.length * ROW_PITCH + actionCount * ACTION_PITCH);
+  for (let i = 0; i < 6; i++) {
+    cv.line([gridLeft + i * cw, gridLeft + i * cw], [bottom, top], {
+      colour: PAL.grid,
+      lw: 0.6,
+      zorder: 1,
+    });
+  }
+  cv.line([MARGIN, gridRight], [top, top], { colour: PAL.grid, lw: 0.8, zorder: 1 });
+  for (const u of units) {
+    const blockH = ROW_PITCH + u.actions.length * ACTION_PITCH;
+    const rowY = y - ROW_PITCH / 2;
+    if (u.reversibility === 'R3' || u.reversibility === 'R4') {
+      cv.rect(gridLeft + 4 * cw, y - blockH, cw, blockH, { face: PAL.emptyCorner, zorder: 0.5 });
+    }
+    rowLabel(cv, rowY, u, gridLeft - 0.1);
+    const red = redRule(u);
+    drawLevelBar(
+      cv,
+      gridLeft,
+      cw,
+      rowY,
+      u.level,
+      0.13,
+      red ? PAL.warning : PAL.ink,
+      red ? 1.3 : 0.5
+    );
+    const ceiling = gridLeft + (u.level + 1) * cw;
+    if (u.policy !== 'none') {
+      cv.diamond(ceiling, rowY, DIAMOND_HALF, { filled: u.policy === 'enforced', colour: PAL.ink });
+    }
+    if (u.tier !== 'T0') {
+      const sx = ceiling + DIAMOND_HALF + 0.03 + SEAT_RADIUS;
+      cv.circle(sx, rowY, SEAT_RADIUS, { face: PAL.people, edge: PAL.people, lw: 0, zorder: 4 });
+      cv.text(sx, rowY, u.tier[1], {
+        colour: '#FFFFFF',
+        ha: 'center',
+        weight: 'bold',
+        zorder: 5,
+      });
+    }
+    let ay = y - ROW_PITCH;
+    for (const [action, level] of u.actions) {
+      const aY = ay - ACTION_PITCH / 2;
+      cv.text(MARGIN + 0.5, aY, truncateToWidth(action, gridLeft - 0.1 - (MARGIN + 0.5)), {
+        colour: PAL.muted,
+      });
+      drawLevelBar(cv, gridLeft, cw, aY, level, 0.05, null, 0);
+      ay -= ACTION_PITCH;
+    }
+    y -= blockH;
+    cv.line([MARGIN, gridRight], [y, y], { colour: PAL.grid, lw: 0.6, zorder: 1 });
+  }
+  drawLegend(
+    cv,
+    cv.width - MARGIN - LEGEND_WIDTH,
+    cv.height - LEGEND_TOP,
+    LEGEND_BOTTOM,
+    LEGEND_WIDTH
+  );
+  return cv;
 }
