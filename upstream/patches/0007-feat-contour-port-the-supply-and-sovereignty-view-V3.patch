+// cspell:ignore zorder
+import { Canvas } from '../canvas.js';
+import {
+  BOX_GAP,
+  BOX_PAD,
+  BOX_TITLE_LINE,
+  FIG_H,
+  FIG_W,
+  FONT_SIZE,
+  FOOTER_BAND,
+  ITEM_GAP,
+  LEGEND_BOTTOM,
+  LEGEND_TOP,
