+} from '../common.js';
+import type { Footprint } from '../common.js';
+import type { ContourModel, ContourPanel, ContourSupplier, ContourUnit } from '../types.js';
+
+type BoxStyle = 'solid' | 'dashed' | 'dotted' | 'area';
+
+/** Something placed inside a box: a mark or a model chip, with the room it takes and how to draw it. */
+interface Leaf {
+  key: string;
+  fp: Footprint;
+  draw: (cv: Canvas, x: number, y: number) => void;
+}
+
+interface BoxOptions {
+  subtitle?: string;
+  fillWidth?: boolean;
+}
+
+interface BoxLook {
+  colour: string;
+  dashes: readonly number[] | null;
+  lw: number;
+  face: string;
+}
+
+const BOX_LOOKS: Record<BoxStyle, BoxLook> = {
+  solid: { colour: PAL.ink, dashes: null, lw: 1.2, face: 'none' },
+  dashed: { colour: PAL.supplier, dashes: [4, 2], lw: 1.0, face: 'none' },
+  dotted: { colour: PAL.nonEu, dashes: [1.2, 1.6], lw: 1.1, face: 'none' },
+  area: { colour: PAL.grid, dashes: null, lw: 0.8, face: PAL.ice },
+};
+
+type Position = [number, number];
+
+/** A titled container that holds leaves or other boxes; it measures, arranges and draws itself. */
+class Box {
+  public readonly leaves: Leaf[] = [];
+  public readonly children: Box[] = [];
+  public readonly subtitle: string;
+  public readonly fillWidth: boolean;
+  private readonly minWidth = 1.6;
+  public w = 0;
+  public h = 0;
+  private x = 0;
+  private y = 0;
+  private titleLines: string[] = [];
+  private leafRows: Leaf[][] = [];
+  private boxRows: Box[][] = [];
+
+  public constructor(
+    public readonly title: string,
+    private readonly style: BoxStyle,
+    { subtitle = '', fillWidth = false }: BoxOptions = {}
+  ) {
+    this.subtitle = subtitle;
+    this.fillWidth = fillWidth;
+  }
+
+  public fitTitle(width: number): void {
+    const inner = width - 2 * BOX_PAD;
+    this.titleLines = [];
+    if (this.title) {
+      this.titleLines.push(truncateToWidth(this.title, inner));
+    }
+    if (this.subtitle) {
+      this.titleLines.push(...wrapToWidth(this.subtitle, inner, FONT_SIZE, 2));
+    }
+  }
+
+  private titleH(): number {
+    return BOX_TITLE_LINE * this.titleLines.length + (this.titleLines.length ? 0.04 : 0);
+  }
+
+  public measure(maxW: number): void {
+    const innerW = maxW - 2 * BOX_PAD;
+    this.fitTitle(maxW);
+    let contentW: number;
+    let contentH: number;
+    this.leafRows = [];
+    this.boxRows = [];
+    if (this.leaves.length) {
+      this.leafRows = flow(this.leaves, innerW, (l) => l.fp.width, ITEM_GAP);
+      contentW = Math.max(
+        ...this.leafRows.map(
+          (r) => r.reduce((s, l) => s + l.fp.width, 0) + ITEM_GAP * (r.length - 1)
+        )
+      );
+      contentH =
+        this.leafRows.reduce((s, r) => s + Math.max(...r.map((l) => l.fp.up + l.fp.down)), 0) +
+        ITEM_GAP * (this.leafRows.length - 1);
+    } else if (this.children.length) {
+      this.children.forEach((c) => c.measure(innerW));
+      this.boxRows = flow(this.children, innerW, (c) => c.w, BOX_GAP);
+      contentW = Math.max(
+        ...this.boxRows.map((r) => r.reduce((s, c) => s + c.w, 0) + BOX_GAP * (r.length - 1))
+      );
+      contentH =
+        this.boxRows.reduce((s, r) => s + Math.max(...r.map((c) => c.h)), 0) +
+        BOX_GAP * (this.boxRows.length - 1);
+    } else {
+      contentW = 0.6;
+      contentH = 0.2;
+    }
+    const wanted = Math.max(
+      contentW,
+      Math.min(
+        1.9,
+        Math.max(
+          this.title ? textWidth(this.title) : 0,
+          this.subtitle ? textWidth(this.subtitle) / 2 + 0.3 : 0
+        )
+      )
+    );
+    const natural = Math.max(this.minWidth, wanted + 2 * BOX_PAD);
+    this.w = this.fillWidth ? maxW : Math.min(maxW, natural);
+    this.fitTitle(this.w);
+    this.h = contentH + 2 * BOX_PAD + this.titleH();
+  }
+
+  /** Places the box with its top left corner at (x, yTop) and records the centre of every leaf. */
+  public arrange(x: number, yTop: number, pos: Map<string, Position>): void {
+    this.x = x;
+    this.y = yTop;
+    let cy = yTop - BOX_PAD - this.titleH();
+    if (this.leaves.length) {
+      for (const row of this.leafRows) {
+        const rowH = Math.max(...row.map((l) => l.fp.up + l.fp.down));
+        const rowUp = Math.max(...row.map((l) => l.fp.up));
+        let cx = x + BOX_PAD;
+        for (const leaf of row) {
+          pos.set(leaf.key, [cx + leaf.fp.left, cy - rowUp]);
+          cx += leaf.fp.width + ITEM_GAP;
+        }
+        cy -= rowH + ITEM_GAP;
+      }
+    } else {
+      const innerW = this.w - 2 * BOX_PAD;
+      for (const row of this.boxRows) {
+        const rowH = Math.max(...row.map((c) => c.h));
+        const extra = innerW - (row.reduce((s, c) => s + c.w, 0) + BOX_GAP * (row.length - 1));
+        let cx = x + BOX_PAD;
+        for (const child of row) {
+          child.w += Math.max(0, extra) / row.length;
+          child.fitTitle(child.w);
+          child.arrange(cx, cy, pos);
+          cx += child.w + BOX_GAP;
+        }
+        cy -= rowH + BOX_GAP;
+      }
+    }
+  }
+
+  public draw(cv: Canvas): void {
+    const { colour, dashes, lw, face } = BOX_LOOKS[this.style];
+    cv.rect(this.x, this.y - this.h, this.w, this.h, {
+      face,
+      edge: colour,
+      lw,
+      dashes,
+      zorder: 1,
+      rounding: 0.08,
+    });
+    const titleColour = this.style === 'area' || this.style === 'solid' ? PAL.ink : colour;
+    this.titleLines.forEach((t, k) => {
+      const first = k === 0 && !!this.title;
+      cv.text(this.x + BOX_PAD, this.y - BOX_PAD - 0.04 - k * BOX_TITLE_LINE, t, {
+        colour: first ? titleColour : PAL.muted,
+        weight: first ? 'bold' : 'normal',
+      });
+    });
+    this.children.forEach((c) => c.draw(cv));
+  }
+}
+
+const markLeaf = (u: ContourUnit): Leaf => ({
+  key: u.id,
+  fp: markFootprint(u),
+  draw: (cv, x, y) => drawMark(cv, x, y, u),
+});
+
+const chipLeaf = (sup: ContourSupplier): Leaf => ({
+  key: `chip:${sup.id}`,
+  fp: { left: 0.3, right: 0.3, up: 0.12, down: 0.12, width: 0.6 },
+  draw: (cv, x, y) => {
+    cv.rect(x - 0.28, y - 0.1, 0.56, 0.2, {
+      face: PAL.background,
+      edge: PAL.supplier,
+      lw: 0.9,
+      rounding: 0.05,
+      zorder: 4,
+    });
+    cv.text(x, y, 'model', { colour: PAL.supplier, ha: 'center', weight: 'bold', zorder: 5 });
+  },
+});
+
+const setDefault = <K, V>(map: Map<K, V>, key: K, make: () => V): V => {
+  let value = map.get(key);
+  if (value === undefined) {
+    value = make();
+    map.set(key, value);
+  }
+  return value;
+};
+
+const sortedValues = <V>(map: Map<string, V>): V[] =>
+  [...map.keys()].sort(compareStrings).map((k) => map.get(k)!);
+
+const PLACEMENT_ROLES = ['hosting', 'application', 'operations', 'model'] as const;
 
 /** V3 The supply and sovereignty view. */
