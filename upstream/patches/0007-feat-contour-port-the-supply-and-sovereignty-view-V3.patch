+import { describe, expect, it } from 'vitest';
+import type { Canvas } from '../canvas.js';
+import { PAL } from '../common.js';
+import type { ContourModel, ContourSupplier, ContourUnit } from '../types.js';
+import { layoutSupply } from './supply.js';
+
+const unit = (id: string, extra: Partial<ContourUnit> = {}): ContourUnit => ({
+  id,
+  name: id,
+  level: 2,
+  reversibility: 'R1',
+  reach: 'S',
+  mode: 3,
+  identity: 'person',
+  policy: 'none',
+  tier: 'T0',
+  evidence: 'none',
+  status: 'active',
+  kinds: [],
+  hosting: 'own-premises',
+  operatedBy: 'self',
+  suppliers: [],
+  actions: [],
+  ...extra,
+});
+
+const supplier = (id: string, extra: Partial<ContourSupplier> = {}): ContourSupplier => ({
+  id,
+  label: `Label of ${id}`,
+  location: null,
+  role: 'hosting',
+  jurisdiction: 'EU',
+  ...extra,
+});
+
+const model = (units: ContourUnit[], suppliers: ContourSupplier[] = []): ContourModel => ({
+  view: 'supply',
+  title: 'Title',
+  subtitle: '',
+  footer: [],
+  panels: [{ name: 'Nordvik', units }],
+  suppliers,
+});
+
+interface Drawn {
+  cv: Canvas;
+  svg: Element;
+  texts: string[];
+  marks: string[];
+  links: number;
+  chips: number;
+}
+
+/** Polylines in the supplier colour: the links, and the one line of the legend entry for a link. */
+const supplierLines = (svg: Element): number =>
+  [...svg.querySelectorAll('polyline')].filter((p) => p.getAttribute('stroke') === PAL.supplier)
+    .length;
+
+const draw = (m: ContourModel): Drawn => {
+  const cv = layoutSupply(m);
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  cv.flush(svg);
+  const texts = [...svg.querySelectorAll('text')].map((t) => t.textContent ?? '');
+  return {
+    cv,
+    svg,
+    texts,
+    marks: [...svg.querySelectorAll('desc[data-unit]')].map((d) => d.getAttribute('data-unit')!),
+    links: supplierLines(svg),
+    chips: texts.filter((t) => t === 'model').length,
+  };
+};
+
+const LEGEND_LINES = (() => {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  layoutSupply(model([])).flush(svg);
+  return supplierLines(svg);
+})();
+
+const hasText = (d: Drawn, part: string) => d.texts.some((t) => t.includes(part));
+
+describe('contour supply view (V3)', () => {
+  it('draws a unit hosted on own premises in the box of the organisation', () => {
+    const d = draw(model([unit('A')]));
+    expect(d.marks).toEqual(['A']);
+    expect(d.texts).toEqual(expect.arrayContaining(['Nordvik', 'EU and EEA']));
+    expect(hasText(d, 'Supplier')).toBe(false);
+    expect(hasText(d, 'Non-EU')).toBe(false);
+    expect(d.cv.height).toBe(7.5);
+  });
+
+  it('places a unit in the box of its declared supplier', () => {
+    const d = draw(
+      model(
+        [unit('A', { hosting: 'eu-supplier', suppliers: ['h'] })],
+        [supplier('h', { role: 'hosting' })]
+      )
+    );
+    expect(d.marks).toEqual(['A']);
+    expect(d.texts).toContain('Supplier: hosting (EU)');
+    expect(d.texts).toContain('Label of h');
+    expect(hasText(d, 'unnamed')).toBe(false);
+    expect(d.links).toBe(LEGEND_LINES);
+  });
+
+  it('ignores a supplier id that the model does not declare', () => {
+    const d = draw(model([unit('A', { hosting: 'eu-supplier', suppliers: ['ghost'] })]));
+    expect(d.marks).toEqual(['A']);
+    expect(d.texts).toContain('Supplier: unnamed (EU)');
+    expect(d.chips).toBe(0);
+  });
+
+  it('draws one chip and two links for a model supplier shared by two units', () => {
+    const d = draw(
+      model(
+        [
+          unit('A', { hosting: 'eu-supplier', suppliers: ['h', 'm'] }),
+          unit('B', { hosting: 'eu-supplier', suppliers: ['h', 'm'] }),
+        ],
+        [supplier('h'), supplier('m', { role: 'model', label: 'Model maker' })]
+      )
+    );
+    expect(d.chips).toBe(1);
+    expect(d.links).toBe(LEGEND_LINES + 2);
+    expect(d.texts).toContain('Supplier: model provider (EU)');
+    expect(d.texts).toContain('Supplier: hosting (EU)');
+  });
+
+  it('draws no chip when the model supplier is also the placement', () => {
+    const d = draw(
+      model(
+        [unit('A', { hosting: 'eu-supplier', suppliers: ['m'] })],
+        [supplier('m', { role: 'model' })]
+      )
+    );
+    expect(d.marks).toEqual(['A']);
+    expect(d.chips).toBe(0);
+    expect(d.links).toBe(LEGEND_LINES);
+  });
+
+  it('puts a non-EU supplier in a box for its jurisdiction', () => {
+    const d = draw(
+      model(
+        [unit('A', { hosting: 'non-eu-supplier', suppliers: ['x'] })],
+        [supplier('x', { jurisdiction: 'non-EU', location: 'United States', role: 'application' })]
+      )
+    );
+    expect(d.texts).toContain('Non-EU jurisdiction: United States');
+    expect(d.texts).toContain('Supplier: application (non-EU)');
+  });
+
+  it('uses the generic boxes for hosting without a declared supplier', () => {
+    const d = draw(
+      model([
+        unit('A', { hosting: 'unknown' }),
+        unit('B', { hosting: 'eea-supplier' }),
+        unit('C', { hosting: 'non-eu-supplier' }),
+      ])
+    );
+    expect(d.marks.sort()).toEqual(['A', 'B', 'C']);
+    expect(d.texts).toContain('Supplier: unnamed (EEA)');
+    // the titles of the two groups may be truncated to the width of their column
+    expect(d.texts.filter((t) => t.startsWith('Non-EU jurisdiction: '))).toHaveLength(2);
+    expect(hasText(d, 'Non-EU jurisdiction: j')).toBe(true);
+    expect(hasText(d, 'Non-EU jurisdiction: o')).toBe(true);
+    expect(d.texts.filter((t) => t === 'Supplier: unnamed (non-EU)')).toHaveLength(2);
+  });
+
+  it('grows the canvas when the boxes need more room', () => {
+    const units = Array.from({ length: 160 }, (_, k) =>
+      unit(`U${String(k).padStart(3, '0')}`, { reach: 'XL' })
+    );
+    const d = draw(model(units));
+    expect(d.marks).toHaveLength(160);
+    expect(d.cv.height).toBeGreaterThan(7.5);
+    expect(d.cv.height * 2).toBe(Math.round(d.cv.height * 2));
+    expect(d.svg.querySelector('rect')?.getAttribute('height')).toBe(String(d.cv.height * 100));
+  });
+
+  it('draws an empty view for a model without units', () => {
+    const d = draw(model([]));
+    expect(d.marks).toEqual([]);
+    expect(d.texts).toEqual(expect.arrayContaining(['EU and EEA', 'Nordvik']));
+    expect(d.cv.height).toBe(7.5);
+  });
+
+  it('draws an empty view for a model without panels', () => {
+    const d = draw({ ...model([]), panels: [] });
+    expect(d.marks).toEqual([]);
+    expect(d.texts).toContain('EU and EEA');
+  });
+});
