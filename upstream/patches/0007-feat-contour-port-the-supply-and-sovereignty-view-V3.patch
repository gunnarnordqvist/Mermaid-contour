+export function layoutSupply(model: ContourModel): Canvas {
+  const panel: ContourPanel = model.panels[0] ?? { name: '', units: [] };
+  const suppliers = new Map(model.suppliers.map((s) => [s.id, s]));
+  const own = new Box(panel.name, 'solid', {
+    subtitle: 'own premises, tenant and data centre',
+    fillWidth: true,
+  });
+  const euBoxes = new Map<string, Box>();
+  const nonEuGroups = new Map<string, Map<string, Box>>();
+  const chipLinks: [string, string][] = [];
+
+  const supplierBox = (sup: ContourSupplier): Box => {
+    const title = `Supplier: ${SUPPLIER_ROLE_NAMES[sup.role].toLowerCase()} (${sup.jurisdiction})`;
+    const make = () => new Box(title, 'dashed', { subtitle: sup.label });
+    if (sup.jurisdiction === 'EU' || sup.jurisdiction === 'EEA') {
+      return setDefault(euBoxes, sup.id, make);
+    }
+    // eslint-disable-next-line @typescript-eslint/prefer-nullish-coalescing -- an empty location is none
+    const group = sup.location || 'outside the EU and the EEA';
+    return setDefault(
+      setDefault(nonEuGroups, group, () => new Map<string, Box>()),
+      sup.id,
+      make
+    );
+  };
+  const genericBox = (hosting: ContourUnit['hosting']): Box => {
+    if (hosting === 'eu-supplier' || hosting === 'eea-supplier') {
+      return setDefault(
+        euBoxes,
+        `generic:${hosting}`,
+        () => new Box(`Supplier: unnamed (${hosting === 'eu-supplier' ? 'EU' : 'EEA'})`, 'dashed')
+      );
+    }
+    const group =
+      hosting === 'non-eu-supplier' ? 'outside the EU and the EEA' : 'jurisdiction unknown';
+    return setDefault(
+      setDefault(nonEuGroups, group, () => new Map<string, Box>()),
+      `generic:${hosting}`,
+      () => new Box('Supplier: unnamed (non-EU)', 'dashed')
+    );
+  };
+  const placement = (u: ContourUnit): ContourSupplier | null => {
+    for (const role of PLACEMENT_ROLES) {
+      for (const sid of u.suppliers) {
+        const sup = suppliers.get(sid);
+        if (sup?.role === role) {
+          return sup;
+        }
+      }
+    }
+    return null;
+  };
+
+  for (const u of panel.units) {
+    let placedIn: ContourSupplier | null = null;
+    if (u.hosting === 'own-premises') {
+      own.leaves.push(markLeaf(u));
+    } else {
+      placedIn = placement(u);
+      (placedIn ? supplierBox(placedIn) : genericBox(u.hosting)).leaves.push(markLeaf(u));
+    }
+    for (const sid of u.suppliers) {
+      const sup = suppliers.get(sid);
+      if (sup?.role === 'model' && sup !== placedIn) {
+        const box = supplierBox(sup);
+        if (!box.leaves.some((l) => l.key === `chip:${sup.id}`)) {
+          box.leaves.push(chipLeaf(sup));
+        }
+        chipLinks.push([u.id, `chip:${sup.id}`]);
+      }
+    }
+  }
+
+  const euArea = new Box('EU and EEA', 'area', { fillWidth: true });
+  euArea.children.push(own, ...sortedValues(euBoxes));
+  const nonEuBoxes = [...nonEuGroups.keys()].sort(compareStrings).map((group) => {
+    const box = new Box(`Non-EU jurisdiction: ${group}`, 'dotted');
+    box.children.push(...sortedValues(nonEuGroups.get(group)!));
+    return box;
+  });
+
+  const plotLeft = MARGIN;
+  const plotRight = FIG_W - MARGIN - LEGEND_WIDTH - 0.3;
+  const plotBottom = FOOTER_BAND + 0.1;
+  const columnGap = 0.2;
+  const totalW = plotRight - plotLeft;
+
+  interface Columns {
+    leftW: number;
+    leftH: number;
+    rightH: number;
+    rows: Box[][];
+  }
+  const measureColumns = (rightW: number): Columns => {
+    const leftW = totalW - rightW - (nonEuBoxes.length ? columnGap : 0);
+    euArea.measure(leftW);
+    nonEuBoxes.forEach((b) => b.measure(rightW));
+    const ordered = [...nonEuBoxes].sort(
+      (a, b) => round(-a.w, 3) - round(-b.w, 3) || compareStrings(a.title, b.title)
+    );
+    const rows = nonEuBoxes.length ? flow(ordered, rightW, (b) => b.w, BOX_GAP) : [];
+    const rightH =
+      rows.reduce((s, r) => s + Math.max(...r.map((b) => b.h)), 0) +
+      BOX_GAP * Math.max(0, rows.length - 1);
+    return { leftW, leftH: euArea.h, rightH, rows };
+  };
+
+  let rightW = 0;
+  if (nonEuBoxes.length) {
+    const n = Math.floor((totalW - 2.6 - 2.6) / 0.1) + 1;
+    let best: { height: number; w: number } | null = null;
+    for (let k = 0; k < n; k++) {
+      const w = round(2.6 + 0.1 * k, 1);
+      const m = measureColumns(w);
+      const height = round(Math.max(m.leftH, m.rightH), 3);
+      if (!best || height < best.height || (height === best.height && w < best.w)) {
+        best = { height, w };
+      }
+    }
+    rightW = best?.w ?? 0;
+  }
+  const { leftW, leftH, rightH, rows } = measureColumns(rightW);
+  const needed = Math.max(leftH, rightH);
+  let height = FIG_H;
+  if (FIG_H - TITLE_BAND - 0.05 - needed < plotBottom) {
+    height = Math.ceil((needed + TITLE_BAND + 0.05 + FOOTER_BAND + 0.1) * 2) / 2;
+  }
+  // The canvas is created only now: the page grows when the boxes need it.
+  const cv = new Canvas(FIG_W, height);
+  drawBackground(cv);
+  drawTitleFooter(cv, model);
+  const plotTop = cv.height - TITLE_BAND - 0.05;
+  const pos = new Map<string, Position>();
+  euArea.arrange(plotLeft, plotTop, pos);
+  let cy = plotTop;
+  const rightX = plotLeft + leftW + columnGap;
+  for (const row of rows) {
+    const extra = rightW - (row.reduce((s, b) => s + b.w, 0) + BOX_GAP * (row.length - 1));
+    let cx = rightX;
+    for (const box of row) {
+      box.w += Math.max(0, extra) / row.length;
+      box.fitTitle(box.w);
+      box.arrange(cx, cy, pos);
+      cx += box.w + BOX_GAP;
+    }
+    cy -= Math.max(...row.map((b) => b.h)) + BOX_GAP;
+  }
+  euArea.draw(cv);
+  nonEuBoxes.forEach((b) => b.draw(cv));
+  for (const [uid, chip] of chipLinks) {
+    const [ux, uy] = pos.get(uid)!;
+    const [chx, chy] = pos.get(chip)!;
+    cv.line([ux, chx], [uy, chy], { colour: PAL.supplier, lw: 0.8, zorder: 2 });
+  }
+  const drawLeaves = (box: Box): void => {
+    for (const l of box.leaves) {
+      const [x, y] = pos.get(l.key)!;
+      l.draw(cv, x, y);
+    }
+    box.children.forEach(drawLeaves);
+  };
+  drawLeaves(euArea);
+  nonEuBoxes.forEach(drawLeaves);
+  drawLegend(
+    cv,
+    cv.width - MARGIN - LEGEND_WIDTH,
+    cv.height - LEGEND_TOP,
+    LEGEND_BOTTOM,
+    LEGEND_WIDTH,
+    1,
+    {
+      containers: true,
+    }
+  );
+  return cv;
 }
