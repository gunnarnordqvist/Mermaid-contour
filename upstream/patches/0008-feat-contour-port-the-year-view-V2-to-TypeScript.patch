-import type { Canvas } from '../canvas.js';
-import type { ContourModel } from '../types.js';
+// cspell:ignore zorder
+import { Canvas } from '../canvas.js';
+import {
+  CELL_V1,
+  COL_LABEL_HEIGHT,
+  FIG,
+  FOOTER_BAND,
+  LEGEND_BOTTOM,
+  LEGEND_TOP,
+  LEGEND_WIDTH,
+  MARGIN,
+  PAL,
+  ROW_LABEL_WIDTH,
+  TITLE_BAND,
+  compareStrings,
+  drawBackground,
+  drawGhost,
+  drawGrid,
+  drawLegend,
+  drawMark,
+  drawTitleFooter,
+  ghostFootprint,
+  gridCentre,
+  layoutInCell,
+  markFootprint,
+  modeColour,
+  round,
+} from '../common.js';
+import type { CellEdge, Footprint, Positions } from '../common.js';
+import type { ContourModel, ContourUnit } from '../types.js';
 
-/** V2 The landscape over time. */
-export function layoutYear(_model: ContourModel): Canvas {
-  throw new Error('contour: view year is not implemented');
+interface YearItem {
+  key: string;
+  fp: Footprint;
+  u: ContourUnit;
+}
+
+/** V2 The landscape over time: the end state, ghosts and trails for what moved, hollow crossed marks for what left. */
+export function layoutYear(model: ContourModel): Canvas {
+  const [start, end] = model.panels;
+  const cv = new Canvas(FIG.W, FIG.H);
+  drawBackground(cv);
+  drawTitleFooter(cv, model);
+  const stripH = 0.2;
+  const x0 = MARGIN + ROW_LABEL_WIDTH;
+  const top = cv.height - TITLE_BAND;
+  const bottom = FOOTER_BAND + stripH;
+  const block = 4 * CELL_V1 + COL_LABEL_HEIGHT;
+  const y0 = round(bottom + COL_LABEL_HEIGHT + (top - bottom - block) / 2, 4);
+  const grid = { x0, y0, cell: CELL_V1 };
+  const before = new Map(start.units.map((u) => [u.id, u]));
+  const after = new Map(end.units.map((u) => [u.id, u]));
+  drawGrid(cv, grid);
+
+  const moved = new Set<string>();
+  for (const [id, b] of before) {
+    const a = after.get(id);
+    if (a && (b.level !== a.level || b.reversibility !== a.reversibility)) {
+      moved.add(id);
+    }
+  }
+  const byCell = new Map<string, YearItem[]>();
+  const add = (u: ContourUnit, key: string, fp: Footprint) => {
+    const k = `${u.level},${u.reversibility}`;
+    const items = byCell.get(k) ?? [];
+    items.push({ key, fp, u });
+    byCell.set(k, items);
+  };
+  const ids = [...new Set([...before.keys(), ...after.keys()])].sort(compareStrings);
+  for (const id of ids) {
+    const a = after.get(id);
+    const b = before.get(id);
+    if (a) {
+      add(a, id, markFootprint(a, { isNew: !b }));
+    } else if (b) {
+      add(b, id, markFootprint(b));
+    }
+  }
+  for (const id of [...moved].sort(compareStrings)) {
+    const b = before.get(id);
+    if (b) {
+      add(b, `${id}@start`, ghostFootprint(b));
+    }
+  }
+  const pos: Positions = Object.create(null) as Positions;
+  for (const items of byCell.values()) {
+    const { level, reversibility } = items[0].u;
+    const [cx, cy] = gridCentre(grid, level, reversibility);
+    let edge: CellEdge = null;
+    if (reversibility === 'R4') {
+      edge = 'top';
+    } else if (reversibility === 'R1') {
+      edge = 'bottom';
+    }
+    const p = layoutInCell(items, grid.cell, grid.cell, edge);
+    for (const k of Object.keys(p)) {
+      pos[k] = [cx + p[k][0], cy + p[k][1]];
+    }
+  }
+  for (const id of ids) {
+    const [x, y] = pos[id];
+    const a = after.get(id);
+    const b = before.get(id);
+    if (a) {
+      drawMark(cv, x, y, a, { isNew: !b });
+      const ghost = pos[`${id}@start`];
+      if (b && moved.has(id) && ghost) {
+        const [gx, gy] = ghost;
+        drawGhost(cv, gx, gy, b);
+        cv.line([gx, x], [gy, y], { colour: modeColour(a.mode), lw: 1.0, zorder: 2.6 });
+      }
+    } else if (b) {
+      drawMark(cv, x, y, b, { hollowOverride: true, crossedOverride: true });
+    }
+  }
+  const stripY = y0 - COL_LABEL_HEIGHT - 0.1;
+  cv.line([x0, x0 + 5 * CELL_V1], [stripY + 0.1, stripY + 0.1], { colour: PAL.grid, lw: 0.8 });
+  cv.text(x0, stripY, `${start.name}  →  ${end.name}`, { weight: 'bold' });
+  drawLegend(
+    cv,
+    cv.width - MARGIN - LEGEND_WIDTH,
+    cv.height - LEGEND_TOP,
+    LEGEND_BOTTOM,
+    LEGEND_WIDTH,
+    1,
+    {
+      trail: true,
+    }
+  );
+  return cv;
 }
