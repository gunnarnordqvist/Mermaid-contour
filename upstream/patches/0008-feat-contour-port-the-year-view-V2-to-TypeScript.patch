+import { beforeEach, describe, expect, it } from 'vitest';
+import type { Diagram } from '../../../Diagram.js';
+import * as configApi from '../../../config.js';
+import { PAL, modeColour } from '../common.js';
+import { ContourDB } from '../db.js';
+import { parser } from '../parser.js';
+import { renderer } from '../renderer.js';
+
+const diagramId = 'contour-year';
+
+const svgElement = () => document.querySelector(`#${diagramId}`)!;
+
+const renderYear = async (body: string) => {
+  configApi.reset();
+  document.body.innerHTML = `<svg id="${diagramId}"></svg>`;
+  const text = `contour-beta\n view year\n title T\n${body}`;
+  const db = new ContourDB();
+  parser.parser = { yy: db } as never;
+  await parser.parse(text);
+  await renderer.draw(text, diagramId, 'test', { db } as unknown as Diagram);
+};
+
+const panel = (name: string, ...units: string[]) =>
+  ` panel "${name}"\n${units.map((u) => `  ${u}`).join('\n')}\n`;
+const unit = (id: string, level: number, rev: string, extra = '') =>
+  `unit ${id} "${id}" level=${level} rev=${rev} reach=S mode=1 ${extra}`;
+
+const markers = (id: string) => svgElement().querySelectorAll(`desc[data-unit="${id}"]`);
+const texts = () => [...svgElement().querySelectorAll('text')].map((t) => t.textContent);
+/** The 1.3 pt crossing strokes of a retired or removed unit, drawn in ink. */
+const crosses = () =>
+  svgElement().querySelectorAll(`polyline[stroke="${PAL.ink}"][stroke-width="1.81"]`);
+/** The trail between a ghost and its mark, in mode 1 colour and 1 pt. */
+const trails = () =>
+  svgElement().querySelectorAll(`polyline[stroke="${modeColour(1)}"][stroke-width="1.39"]`);
+/** The open circles of the ghosts, in mode 1 colour. */
+const ghosts = () =>
+  svgElement().querySelectorAll(`circle[fill="none"][stroke="${modeColour(1)}"]`);
+
+describe('contour V2, the landscape over time', () => {
+  beforeEach(() => {
+    configApi.reset();
+  });
+
+  it('draws a unit that moved once, with a ghost at its start and a trail', async () => {
+    await renderYear(panel('Start', unit('A', 1, 'R1')) + panel('End', unit('A', 3, 'R2')));
+    expect(markers('A')).toHaveLength(1);
+    expect(ghosts()).toHaveLength(1);
+    expect(trails()).toHaveLength(1);
+    expect(crosses()).toHaveLength(0);
+    expect(texts()).toContain('Start  →  End');
+  });
+
+  it('marks a unit that is only in the end panel as new', async () => {
+    await renderYear(
+      panel('Start', unit('A', 1, 'R1')) + panel('End', unit('A', 1, 'R1'), unit('B', 2, 'R2'))
+    );
+    expect(markers('B')).toHaveLength(1);
+    expect(texts().filter((t) => t === 'new')).toHaveLength(1);
+    expect(ghosts()).toHaveLength(0);
+  });
+
+  it('draws a unit only in the start panel hollow and crossed', async () => {
+    await renderYear(
+      panel('Start', unit('A', 1, 'R1'), unit('B', 2, 'R2')) + panel('End', unit('A', 1, 'R1'))
+    );
+    expect(markers('B')).toHaveLength(1);
+    expect(crosses()).toHaveLength(2);
+    expect(trails()).toHaveLength(0);
+  });
+
+  it('draws identical panels without ghosts, trails or new ticks', async () => {
+    const p = [unit('A', 1, 'R1'), unit('B', 4, 'R4')];
+    await renderYear(panel('Start', ...p) + panel('End', ...p));
+    expect(markers('A')).toHaveLength(1);
+    expect(markers('B')).toHaveLength(1);
+    expect(ghosts()).toHaveLength(0);
+    expect(trails()).toHaveLength(0);
+    expect(crosses()).toHaveLength(0);
+    expect(texts().filter((t) => t === 'new')).toHaveLength(0);
+  });
+
+  it('draws the grid and the legend for empty panels', async () => {
+    await renderYear(` panel "Start"\n panel "End"\n`);
+    expect(svgElement().querySelectorAll('desc[data-unit]')).toHaveLength(0);
+    expect(texts()).toEqual(expect.arrayContaining(['Start  →  End', 'the empty corner', 'Trail']));
+  });
+
+  it('keeps every mark of a crowded cell, ghosts included, apart', async () => {
+    const ids = ['A', 'B', 'C', 'D', 'E', 'F'];
+    await renderYear(
+      panel('Start', ...ids.map((id) => unit(id, 2, 'R2')), unit('G', 0, 'R1')) +
+        panel('End', ...ids.map((id) => unit(id, 2, 'R2')), unit('G', 2, 'R2'))
+    );
+    const pos = [...ids, 'G'].map((id) => {
+      const m = markers(id);
+      expect(m).toHaveLength(1);
+      return [Number(m[0].getAttribute('data-x')), Number(m[0].getAttribute('data-y'))];
+    });
+    for (let i = 0; i < pos.length; i++) {
+      for (let j = i + 1; j < pos.length; j++) {
+        const d = Math.hypot(pos[i][0] - pos[j][0], pos[i][1] - pos[j][1]);
+        expect(d).toBeGreaterThan(0.15);
+      }
+    }
+    expect(ghosts()).toHaveLength(1);
+  });
+});
